      target_content: "export type Book = {\n  id: string;\n  title: string;\n  author: string;\n  category: string;\n  coverColor: string;\n  excerpt: string;\n  chapters: { title: string; content: string }[];\n};\n\nexport const categories = [\n  \'Psychological\',\n  \'Astronomy\',\n  \'Sci-Fi\',\n  \'Philosophy\',\n  \'Mysticism\'\n];\n\nexport const books: Book[] = [\n  {\n    id: \'psy-1\',\n    title: \'Echoes of the Ego\',\n    author: \'S. Vance\',\n    category: \'Psychological\',\n    coverColor: \'bg-[#2A2A35]\',\n    excerpt: \'An exploration into the depths of the human mind and its hidden drivers.\',\n    chapters: [\n      { title: \'Chapter 1: The Mirror\', content: \'We look into the mirror and see only what we want to see. The ego is a master illusionist, painting over our true intentions. Through deep contemplation, one can distinguish the facade from the true self.\' },\n      { title: \'Chapter 2: Shadows\', content: \'Where light touches, shadows are cast. Our psychological shadows hold the key to our hidden potential. To walk in the light, one must first befriend the dark.\' },\n    ]\n  },\n  {\n    id: \'psy-2\',\n    title: \'The Painted Mind\',\n    author: \'Dr. E. Rose\',\n    category: \'Psychological\',\n    coverColor: \'bg-zinc-800\',\n    excerpt: \'How our perceptions paint the reality we live in.\',\n    chapters: [\n      { title: \'Chapter 1: Perception vs Reality\', content: \'Our mind is a canvas, and our experiences are the paint. But who is holding the brush?\' },\n    ]\n  },\n  {\n    id: \'ast-1\',\n    title: \'The Deep Universe\',\n    author: \'Arthur C.\',\n    category: \'Astronomy\',\n    coverColor: \'bg-[#18181b]\',\n    excerpt: \'A comprehensive guide to the cosmos and the stars beyond.\',\n    chapters: [\n      { title: \'Chapter 1: The Void\', content: \'In the vastness of space, the silence is deafening. Yet, in this silence, the universe speaks. The expansion is not just physical; it is a manifestation of potential.\' },\n    ]\n  },\n  {\n    id: \'sci-1\',\n    title: \'Neon Horizons\',\n    author: \'L. T. Ford\',\n    category: \'Sci-Fi\',\n    coverColor: \'bg-zinc-900\',\n    excerpt: \'A tale of a dystopian future where humanity reaches the stars.\',\n    chapters: [\n      { title: \'Chapter 1: The Launch\', content: \'The engines roared, a sound that shook the very foundations of the earth. We were leaving.\' },\n    ]\n  },\n  {\n    id: \'phi-1\',\n    title: \'The Unexamined Life\',\n    author: \'Marcus Aurelio\',\n    category: \'Philosophy\',\n    coverColor: \'bg-neutral-800\',\n    excerpt: \'Thoughts on the meaning of existence and the nature of being.\',\n    chapters: [\n      { title: \'Chapter 1: The Question\', content: \'Why are we here? It is the question that has plagued humanity since the dawn of time.\' },\n    ]\n  },\n  {\n    id: \'mys-1\',\n    title: \'Whispers of the Celestial\',\n    author: \'Elara Moon\',\n    category: \'Mysticism\',\n    coverColor: \'bg-[#1C1A24]\',\n    excerpt: \'Connecting with the ethereal forces of the universe.\',\n    chapters: [\n      { title: \'Chapter 1: The Alignment\', content: \'When the stars align, the veil between worlds thins. Listen closely. The cosmos does not shout; it murmurs secrets to those willing to attune their frequencies.\' },\n    ]\n  }\n];"
      replacement_content: "export type Book = {\n  id: string;\n  title: string;\n  author: string;\n  category: string;\n  coverColor: string;\n  excerpt: string;\n  summary: string;\n  readTimeMn: number;\n  chapters: { title: string; content: string }[];\n};\n\nexport const categories = [\n  \'Psychological\',\n  \'Astronomy\',\n  \'Sci-Fi\',\n  \'Philosophy\',\n  \'Mysticism\',\n  \'Esoteric\'\n];\n\nexport const books: Book[] = [\n  {\n    id: \'psy-1\',\n    title: \'Echoes of the Ego\',\n    author: \'S. Vance\',\n    category: \'Psychological\',\n    coverColor: \'bg-[#2A2A35]\',\n    excerpt: \'An exploration into the depths of the human mind and its hidden drivers.\',\n    summary: \'Dive deep into the intricate layers of human consciousness. Vance masterfully dissects the illusions we create to protect our vulnerability, offering a path to radical self-acceptance.\',\n    readTimeMn: 120,\n    chapters: [\n      { title: \'Chapter 1: The Mirror\', content: \'We look into the mirror and see only what we want to see. The ego is a master illusionist, painting over our true intentions. Through deep contemplation, one can distinguish the facade from the true self.\' },\n      { title: \'Chapter 2: Shadows\', content: \'Where light touches, shadows are cast. Our psychological shadows hold the key to our hidden potential. To walk in the light, one must first befriend the dark.\' },\n    ]\n  },\n  {\n    id: \'psy-2\',\n    title: \'The Painted Mind\',\n    author: \'Dr. E. Rose\',\n    category: \'Psychological\',\n    coverColor: \'bg-zinc-800\',\n    excerpt: \'How our perceptions paint the reality we live in.\',\n    summary: \'A revolutionary look at cognitive framing. Dr. Rose explores how our past traumas and triumphs act as lenses, coloring every present moment and dictating our future potential.\',\n    readTimeMn: 95,\n    chapters: [\n      { title: \'Chapter 1: Perception vs Reality\', content: \'Our mind is a canvas, and our experiences are the paint. But who is holding the brush?\' },\n    ]\n  },\n  {\n    id: \'ast-1\',\n    title: \'The Deep Universe\',\n    author: \'Arthur C.\',\n    category: \'Astronomy\',\n    coverColor: \'bg-[#18181b]\',\n    excerpt: \'A comprehensive guide to the cosmos and the stars beyond.\',\n    summary: \'A journey beyond our solar system into the uncharted territories of deep space. Discover quasars, dark matter, and the cosmic web that binds galaxies together.\',\n    readTimeMn: 240,\n    chapters: [\n      { title: \'Chapter 1: The Void\', content: \'In the vastness of space, the silence is deafening. Yet, in this silence, the universe speaks. The expansion is not just physical; it is a manifestation of potential.\' },\n    ]\n  },\n  {\n    id: \'sci-1\',\n    title: \'Neon Horizons\',\n    author: \'L. T. Ford\',\n    category: \'Sci-Fi\',\n    coverColor: \'bg-zinc-900\',\n    excerpt: \'A tale of a dystopian future where humanity reaches the stars.\',\n    summary: \'Following the collapse of Earth\\\'s ecosystem, a fragmented humanity aboard generation ships seeks a new home. A gripping tale of survival, betrayal, and the indomitable human spirit.\',\n    readTimeMn: 180,\n    chapters: [\n      { title: \'Chapter 1: The Launch\', content: \'The engines roared, a sound that shook the very foundations of the earth. We were leaving.\' },\n    ]\n  },\n  {\n    id: \'phi-1\',\n    title: \'The Unexamined Life\',\n    author: \'Marcus Aurelio\',\n    category: \'Philosophy\',\n    coverColor: \'bg-neutral-800\',\n    excerpt: \'Thoughts on the meaning of existence and the nature of being.\',\n    summary: \'A modern translation and interpretation of stoic principles. Aurelio distills ancient wisdom for contemporary minds battling the noise of the digital age.\',\n    readTimeMn: 150,\n    chapters: [\n      { title: \'Chapter 1: The Question\', content: \'Why are we here? It is the question that has plagued humanity since the dawn of time.\' },\n    ]\n  },\n  {\n    id: \'mys-1\',\n    title: \'Whispers of the Celestial\',\n    author: \'Elara Moon\',\n    category: \'Mysticism\',\n    coverColor: \'bg-[#1C1A24]\',\n    excerpt: \'Connecting with the ethereal forces of the universe.\',\n    summary: \'An intimate grimoire of cosmic meditations. Moon guides the reader on how to attune to the subtle frequencies of planetary bodies and harvest their energetic resonance.\',\n    readTimeMn: 110,\n    chapters: [\n      { title: \'Chapter 1: The Alignment\', content: \'When the stars align, the veil between worlds thins. Listen closely. The cosmos does not shout; it murmurs secrets to those willing to attune their frequencies.\' },\n    ]\n  },\n  {\n    id: \'eso-1\',\n    title: \'The Silent Arcana\',\n    author: \'J.T. Vane\',\n    category: \'Esoteric\',\n    coverColor: \'bg-[#2A2A20]\',\n    excerpt: \'Deciphering the lost symbols of the old world.\',\n    summary: \'A meticulous breakdown of forgotten symbolic languages. From ancient masonry to the sacred geometry mapping the stars, Vane uncovers the hidden texts that shaped our history.\',\n    readTimeMn: 210,\n    chapters: [\n      { title: \'Chapter 1: The First Symbol\', content: \'Before the written word, there was the shape. The circle, the line, the intersection. These were not arbitrary; they were profound acknowledgments of the surrounding order.\' },\n    ]\n  }\n];"
