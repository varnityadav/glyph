      replacement_content: "export type Book = {\n  id: string;\n  title: string;\n  author: string;\n  category: string;\n  coverColor: string;\n  excerpt: string;\n  chapters: { title: string; content: string }[];\n};\n\nexport const categories = [\n  \'Psychological\',\n  \'Astronomy\',\n  \'Sci-Fi\',\n  \'Philosophy\',\n  \'Mysticism\'\n];\n\nexport const books: Book[] = [\n  {\n    id: \'psy-1\',\n    title: \'Echoes of the Ego\',\n    author: \'S. Vance\',\n    category: \'Psychological\',\n    coverColor: \'bg-lavender-900\',\n    excerpt: \'An exploration into the depths of the human mind and its hidden drivers.\',\n    chapters: [\n      { title: \'Chapter 1: The Mirror\', content: \'We look into the mirror and see only what we want to see. The ego is a master illusionist, painting over our true intentions...\' },\n      { title: \'Chapter 2: Shadows\', content: \'Where light touches, shadows are cast. Our psychological shadows hold the key to our hidden potential...\' },\n    ]\n  },\n  {\n    id: \'psy-2\',\n    title: \'The Painted Mind\',\n    author: \'Dr. E. Rose\',\n    category: \'Psychological\',\n    coverColor: \'bg-zinc-800\',\n    excerpt: \'How our perceptions paint the reality we live in.\',\n    chapters: [\n      { title: \'Chapter 1: Perception vs Reality\', content: \'Our mind is a canvas, and our experiences are the paint. But who is holding the brush?\' },\n    ]\n  },\n  {\n    id: \'ast-1\',\n    title: \'The Deep Universe\',\n    author: \'Arthur C.\',\n    category: \'Astronomy\',\n    coverColor: \'bg-slate-800\',\n    excerpt: \'A comprehensive guide to the cosmos and the stars beyond.\',\n    chapters: [\n      { title: \'Chapter 1: The Void\', content: \'In the vastness of space, the silence is deafening. Yet, in this silence, the universe speaks.\' },\n    ]\n  },\n  {\n    id: \'sci-1\',\n    title: \'Neon Horizons\',\n    author: \'L. T. Ford\',\n    category: \'Sci-Fi\',\n    coverColor: \'bg-zinc-900\',\n    excerpt: \'A tale of a dystopian future where humanity reaches the stars.\',\n    chapters: [\n      { title: \'Chapter 1: The Launch\', content: \'The engines roared, a sound that shook the very foundations of the earth. We were leaving.\' },\n    ]\n  },\n  {\n    id: \'phi-1\',\n    title: \'The Unexamined Life\',\n    author: \'Marcus Aurelio\',\n    category: \'Philosophy\',\n    coverColor: \'bg-neutral-800\',\n    excerpt: \'Thoughts on the meaning of existence and the nature of being.\',\n    chapters: [\n      { title: \'Chapter 1: The Question\', content: \'Why are we here? It is the question that has plagued humanity since the dawn of time.\' },\n    ]\n  },\n  {\n    id: \'mys-1\',\n    title: \'Whispers of the Celestial\',\n    author: \'Elara Moon\',\n    category: \'Mysticism\',\n    coverColor: \'bg-lavender-800\',\n    excerpt: \'Connecting with the ethereal forces of the universe.\',\n    chapters: [\n      { title: \'Chapter 1: The Alignment\', content: \'When the stars align, the veil between worlds thins. Listen closely.\' },\n    ]\n  }\n];\n"
