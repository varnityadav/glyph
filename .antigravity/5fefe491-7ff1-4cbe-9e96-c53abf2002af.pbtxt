  file_change {
    absolute_path_uri: "file:///src/components/CelestialBackground.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React from \'react\';\nimport { motion } from \'motion/react\';\n\nexport default function CelestialBackground() {\n  // Generate random stars\n  const stars = Array.from({ length: 200 }).map((_, i) => ({\n    id: i,\n    x: Math.random() * 100,\n    y: Math.random() * 100,\n    size: Math.random() * 2.5 + 0.5,\n    delay: Math.random() * 5,\n    duration: Math.random() * 4 + 2,\n  }));\n\n  return (\n    <div className=\"fixed inset-0 z-0 overflow-hidden bg-[#0A0710]\">\n      {/* Deep universe radial gradient */}\n      <div className=\"absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-[#1f103b]/80 via-[#0A0710] to-[#050308]\"></div>\n      \n      {/* Vivid Nebula effects representing the deep cosmic glow */}\n      <motion.div \n        animate={{ rotate: 360, scale: [1, 1.1, 1] }} \n        transition={{ duration: 120, repeat: Infinity, ease: \"linear\" }}\n        className=\"absolute top-[-30%] left-[-20%] w-[90%] h-[90%] rounded-full bg-fuchsia-900/20 blur-[140px] mix-blend-screen\"\n      ></motion.div>\n      <motion.div \n        animate={{ rotate: -360, scale: [1, 1.2, 1] }} \n        transition={{ duration: 150, repeat: Infinity, ease: \"linear\" }}\n        className=\"absolute bottom-[-30%] right-[-20%] w-[80%] h-[80%] rounded-full bg-violet-800/20 blur-[130px] mix-blend-screen\"\n      ></motion.div>\n      <div className=\"absolute top-[20%] right-[10%] w-[40%] h-[40%] rounded-full bg-indigo-900/20 blur-[120px] mix-blend-screen\"></div>\n\n      {/* Stars */}\n      <div className=\"absolute inset-0\">\n        {stars.map((star) => (\n          <motion.div\n            key={star.id}\n            className=\"absolute rounded-full bg-white shadow-[0_0_10px_rgba(255,255,255,0.8)]\"\n            style={{\n              left: `${star.x}%`,\n              top: `${star.y}%`,\n              width: `${star.size}px`,\n              height: `${star.size}px`,\n            }}\n            animate={{\n              opacity: [0.1, 0.9, 0.1],\n              scale: [1, 1.3, 1],\n            }}\n            transition={{\n              duration: star.duration,\n              repeat: Infinity,\n              delay: star.delay,\n              ease: \"easeInOut\",\n            }}\n          />\n        ))}\n      </div>\n    </div>\n  );\n}"
      replacement_content: "import React, { useEffect } from \'react\';\nimport { motion, useMotionValue, useSpring } from \'motion/react\';\n\nexport default function CelestialBackground() {\n  const mouseX = useMotionValue(0);\n  const mouseY = useMotionValue(0);\n\n  const springX = useSpring(mouseX, { stiffness: 30, damping: 20 });\n  const springY = useSpring(mouseY, { stiffness: 30, damping: 20 });\n\n  useEffect(() => {\n    const handleMouseMove = (e: MouseEvent) => {\n      const offsetX = (e.clientX / window.innerWidth - 0.5) * 60; // Max movement 30px\n      const offsetY = (e.clientY / window.innerHeight - 0.5) * 60;\n      mouseX.set(offsetX);\n      mouseY.set(offsetY);\n    };\n\n    window.addEventListener(\'mousemove\', handleMouseMove);\n    return () => window.removeEventListener(\'mousemove\', handleMouseMove);\n  }, [mouseX, mouseY]);\n\n  // Generate random stars\n  const stars = Array.from({ length: 200 }).map((_, i) => ({\n    id: i,\n    x: Math.random() * 100,\n    y: Math.random() * 100,\n    size: Math.random() * 2 + 0.5,\n    delay: Math.random() * 5,\n    duration: Math.random() * 4 + 3,\n  }));\n\n  return (\n    <div className=\"fixed inset-0 z-0 overflow-hidden bg-[#111116]\">\n      {/* Deep universe radial gradient */}\n      <div className=\"absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-[#1d1b26] via-[#111116] to-[#0a0a0f]\"></div>\n      \n      {/* Interactive layer using cursor position */}\n      <motion.div \n        className=\"absolute inset-0\"\n        style={{ x: springX, y: springY }}\n      >\n        {/* Subtle, natural gray and soft lavender glow */}\n        <div className=\"absolute top-[-30%] left-[-20%] w-[90%] h-[90%] rounded-full bg-slate-500/10 blur-[150px] mix-blend-screen mix-blend-lighten\"></div>\n        <div className=\"absolute bottom-[-30%] right-[-20%] w-[80%] h-[80%] rounded-full bg-lavender-900/10 blur-[150px] mix-blend-screen mix-blend-lighten\"></div>\n        <div className=\"absolute top-[20%] right-[10%] w-[40%] h-[40%] rounded-full bg-stone-500/5 blur-[120px] mix-blend-screen mix-blend-lighten\"></div>\n\n        {/* Stars */}\n        <div className=\"absolute inset-0\">\n          {stars.map((star) => (\n            <motion.div\n              key={star.id}\n              className=\"absolute rounded-full bg-white/80\"\n              style={{\n                left: `${star.x}%`,\n                top: `${star.y}%`,\n                width: `${star.size}px`,\n                height: `${star.size}px`,\n              }}\n              animate={{\n                opacity: [0.2, 0.8, 0.2],\n                scale: [1, 1.1, 1],\n              }}\n              transition={{\n                duration: star.duration,\n                repeat: Infinity,\n                delay: star.delay,\n                ease: \"easeInOut\",\n              }}\n            />\n          ))}\n        </div>\n      </motion.div>\n    </div>\n  );\n}\n"
    }
