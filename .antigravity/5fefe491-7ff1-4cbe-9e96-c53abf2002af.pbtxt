  file_change {
    absolute_path_uri: "file:///src/components/Book3D.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { Book as BookIcon } from \'lucide-react\';\nimport { Book } from \'../data\';\n\nexport default function Book3D({ book, onClick }: { book: Book | null; onClick: () => void }) {\n  if (!book) {\n    return (\n      <div className=\"flex flex-col items-center justify-center h-full w-full opacity-50\">\n        <BookIcon className=\"w-16 h-16 text-white/50 mb-4\" />\n        <p className=\"text-white/60 font-sans tracking-widest uppercase text-sm\">Select a tome</p>\n      </div>\n    );\n  }\n\n  // A 3D Book representation rotating\n  return (\n    <div className=\"relative w-full h-full flex items-center justify-center perspective-[1200px]\">\n      <motion.div\n        className=\"relative w-48 h-72 preserve-3d cursor-pointer group\"\n        animate={{\n          y: [-15, 15, -15],\n          rotateY: [0, 360],\n          rotateX: [5, 10, 5],\n        }}\n        transition={{\n          y: { duration: 6, repeat: Infinity, ease: \"easeInOut\" },\n          rotateY: { duration: 20, repeat: Infinity, ease: \"linear\" },\n          rotateX: { duration: 8, repeat: Infinity, ease: \"easeInOut\" },\n        }}\n        onClick={onClick}\n      >\n        {/* Front Cover */}\n        <div \n          className={`absolute inset-0 ${book.coverColor} rounded-r-md border-l border-white/10 shadow-xl overflow-hidden`}\n          style={{ transform: \'translateZ(20px)\' }}\n        >\n          <div className=\"absolute inset-0 bg-gradient-to-tr from-black/40 to-transparent\"></div>\n          <div className=\"p-6 flex flex-col h-full justify-between relative z-10\">\n            <h3 className=\"font-serif text-white text-xl font-medium leading-tight text-center mt-8\">{book.title}</h3>\n            <p className=\"font-sans text-white/60 text-xs text-center uppercase tracking-widest\">{book.author}</p>\n          </div>\n        </div>\n\n        {/* Back Cover */}\n        <div \n          className={`absolute inset-0 ${book.coverColor} rounded-l-md border-r border-white/10`}\n          style={{ transform: \'rotateY(180deg) translateZ(20px)\' }}\n        >\n          <div className=\"absolute inset-0 bg-black/20\"></div>\n        </div>\n\n        {/* Spine */}\n        <div \n          className={`absolute top-0 bottom-0 ${book.coverColor} brightness-75`}\n          style={{ \n            width: \'40px\', \n            left: 0, \n            transformOrigin: \'left\', \n            transform: \'rotateY(-90deg) translateZ(0)\' \n          }}\n        >\n          <div className=\"w-full h-full flex items-center justify-center py-8\">\n             <span className=\"font-serif text-white/80 text-xs truncate w-48 -rotate-90 origin-center absolute flex items-center justify-center\">{book.title}</span>\n          </div>\n        </div>\n\n        {/* Top Pages */}\n        <div \n          className=\"absolute bg-[#e8e6e3]\"\n          style={{ \n            width: \'192px\', // same as outer w-48\n            height: \'38px\', // slightly less than 40 to fit inside covers\n            top: 0,\n            transformOrigin: \'top\',\n            transform: \'rotateX(-90deg) translateZ(-1px)\'\n          }}\n        >\n          {/* page lines texture */}\n          <div className=\"w-full h-full bg-[repeating-linear-gradient(to_bottom,transparent,transparent_1px,rgba(0,0,0,0.05)_1px,rgba(0,0,0,0.05)_2px)]\"></div>\n        </div>\n\n        {/* Right Pages */}\n         <div \n          className=\"absolute bg-[#e8e6e3]\"\n          style={{ \n            width: \'38px\', \n            height: \'288px\', // same as outer h-72\n            right: 0,\n            top: 0,\n            transformOrigin: \'right\',\n            transform: \'rotateY(90deg) translateZ(0px)\'\n          }}\n        >\n          {/* page lines texture */}\n          <div className=\"w-full h-full bg-[repeating-linear-gradient(to_right,transparent,transparent_1px,rgba(0,0,0,0.05)_1px,rgba(0,0,0,0.05)_2px)]\"></div>\n        </div>\n\n        {/* Bottom Pages */}\n         <div \n          className=\"absolute bg-[#e8e6e3]\"\n          style={{ \n            width: \'192px\', \n            height: \'38px\', \n            bottom: 0,\n            transformOrigin: \'bottom\',\n            transform: \'rotateX(90deg) translateZ(-1px)\'\n          }}\n        >\n           <div className=\"w-full h-full bg-[repeating-linear-gradient(to_bottom,transparent,transparent_1px,rgba(0,0,0,0.05)_1px,rgba(0,0,0,0.05)_2px)]\"></div>\n        </div>\n\n      </motion.div>\n\n      {/* Shadow on floor */}\n      <motion.div \n        className=\"absolute bottom-[10%] w-32 h-8 bg-black/40 blur-xl rounded-[100%]\"\n        animate={{\n          scale: [0.8, 1, 0.8],\n          opacity: [0.3, 0.1, 0.3]\n        }}\n        transition={{ duration: 6, repeat: Infinity, ease: \"easeInOut\" }}\n      />\n    </div>\n  );\n}\n"
    }
    diff {
