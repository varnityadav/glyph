      replacement_content: "import React from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { X } from \'lucide-react\';\nimport { Book } from \'../data\';\n\nexport default function ReaderOverlay({ book, onClose }: { book: Book | null; onClose: () => void }) {\n  return (\n    <AnimatePresence>\n      {book && (\n        <motion.div \n          className=\"fixed inset-0 z-50 flex items-center justify-center p-4 lg:p-12\"\n          initial={{ opacity: 0 }}\n          animate={{ opacity: 1 }}\n          exit={{ opacity: 0 }}\n        >\n          {/* Backdrop */}\n          <div className=\"absolute inset-0 bg-[#0B0A10]/80 backdrop-blur-md\" onClick={onClose}></div>\n          \n          {/* Reader container */}\n          <motion.div \n            className=\"relative w-full max-w-4xl h-full max-h-[85vh] liquid-glass-strong rounded-3xl overflow-hidden flex flex-col\"\n            initial={{ y: 20, scale: 0.95 }}\n            animate={{ y: 0, scale: 1 }}\n            exit={{ y: 20, scale: 0.95 }}\n          >\n            {/* Header */}\n            <div className=\"flex items-center justify-between p-6 border-b border-white/10\">\n              <div>\n                <h2 className=\"font-serif text-white text-2xl font-medium tracking-tight mb-1\">{book.title}</h2>\n                <p className=\"font-sans text-white/50 text-xs tracking-widest uppercase\">{book.author}</p>\n              </div>\n              <button \n                onClick={onClose}\n                className=\"w-10 h-10 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center transition-colors text-white/70 hover:text-white\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            {/* Content Body */}\n            <div className=\"flex-1 overflow-auto p-8 lg:p-12 space-y-12 scrollbar-hide\">\n              {book.chapters.map((chapter, idx) => (\n                <div key={idx} className=\"max-w-2xl mx-auto\">\n                  <h3 className=\"font-sans text-white/80 text-sm tracking-widest uppercase mb-6 text-center\">{chapter.title}</h3>\n                  <p className=\"font-serif text-white/90 text-lg lg:text-xl leading-relaxed\">\n                    {chapter.content}\n                  </p>\n                  \n                  {/* Mock content filler to show scrolling */}\n                  <div className=\"mt-8 space-y-6 opacity-30 blur-[1px]\">\n                    <div className=\"h-4 bg-white/40 rounded w-full\"></div>\n                    <div className=\"h-4 bg-white/40 rounded w-[90%]\"></div>\n                    <div className=\"h-4 bg-white/40 rounded w-[95%]\"></div>\n                    <div className=\"h-4 bg-white/40 rounded w-[80%]\"></div>\n                  </div>\n                </div>\n              ))}\n            </div>\n            \n            <div className=\"p-4 border-t border-white/10 flex justify-center\">\n               <span className=\"font-sans text-white/30 text-xs tracking-widest uppercase\">{book.category} Anthology</span>\n            </div>\n          </motion.div>\n        </motion.div>\n      )}\n    </AnimatePresence>\n  );\n}\n"
    }
