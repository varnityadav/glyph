    instruction: "Update hero section buttons and bg to match new cliff aesthetic, and add horoscope entry"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useRef } from \'react\';\nimport { motion, useInView } from \'motion/react\';\nimport { ArrowRight, Check } from \'lucide-react\';\nimport { WordsPullUp, WordsPullUpMultiStyle, ScrollRevealText } from \'./AnimatedText\';\n\ninterface LandingPageProps {\n  onEnter: () => void;\n}\n\nexport default function LandingPage({ onEnter }: LandingPageProps) {\n  const featureRef = useRef(null);\n  const isFeatureInView = useInView(featureRef, { once: true, margin: \"-100px\" });\n\n  return (\n    <div className=\"bg-black min-h-screen text-primary selection:bg-primary/20\">\n      {/* SECTION 1: HERO */}\n      <section className=\"h-screen p-4 md:p-6\">\n        <div className=\"relative w-full h-full rounded-2xl md:rounded-[2rem] overflow-hidden bg-black isolation\">\n          {/* Background Video */}\n          <video\n            autoPlay\n            loop\n            muted\n            playsInline\n            className=\"absolute inset-0 w-full h-full object-cover\"\n            src=\"https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260405_170732_8a9ccda6-5cff-4628-b164-059c500a2b41.mp4\"\n          />\n          {/* Overlays */}\n          <div className=\"absolute inset-0 noise-overlay opacity-[0.7] mix-blend-overlay pointer-events-none\"></div>\n          <div className=\"absolute inset-0 bg-gradient-to-b from-black/30 via-transparent to-black/60\"></div>\n\n          {/* Navbar */}\n          <div className=\"absolute top-0 left-1/2 -translate-x-1/2 bg-black rounded-b-2xl md:rounded-b-3xl px-4 py-3 md:px-8 flex items-center justify-center gap-3 sm:gap-6 md:gap-12 lg:gap-14 z-20\">\n            {[\'Our story\', \'Collective\', \'Workshops\', \'Programs\', \'Inquiries\'].map((item) => (\n              <a\n                key={item}\n                href={`#${item.toLowerCase().replace(\' \', \'-\')}`}\n                className=\"text-[10px] sm:text-xs md:text-sm whitespace-nowrap transition-colors\"\n                style={{ color: \'rgba(225, 224, 204, 0.8)\' }}\n                onMouseEnter={(e) => e.currentTarget.style.color = \'#E1E0CC\'}\n                onMouseLeave={(e) => e.currentTarget.style.color = \'rgba(225, 224, 204, 0.8)\'}\n              >\n                {item}\n              </a>\n            ))}\n          </div>\n\n          {/* Hero Content */}\n          <div className=\"absolute bottom-0 left-0 right-0 p-6 md:p-12 lg:p-16 z-20\">\n            <div className=\"grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-0 items-end\">\n              <div className=\"md:col-span-8\">\n                <WordsPullUp \n                  text=\"glyph\" \n                  showAsterisk={true} \n                  className=\"text-[26vw] sm:text-[24vw] md:text-[22vw] lg:text-[20vw] xl:text-[19vw] 2xl:text-[20vw] font-medium leading-[0.85] tracking-[-0.07em] lowercase\" \n                  style={{ color: \'#E1E0CC\' }}\n                />\n              </div>\n              <div className=\"md:col-span-4 flex flex-col items-start gap-8 md:pb-6\">\n                <motion.p \n                  initial={{ opacity: 0, y: 20 }}\n                  animate={{ opacity: 1, y: 0 }}\n                  transition={{ delay: 0.5, duration: 0.8, ease: [0.16, 1, 0.3, 1] }}\n                  className=\"text-primary/70 text-xs sm:text-sm md:text-base leading-[1.2]\"\n                >\n                  glyph. is a worldwide network of readers, philosophers and storytellers bound not by place, status or labels but by passion and hunger to unlock potential through our curated perspectives.\n                </motion.p>\n                \n                <motion.button \n                  initial={{ opacity: 0, y: 20 }}\n                  animate={{ opacity: 1, y: 0 }}\n                  transition={{ delay: 0.7, duration: 0.8, ease: [0.16, 1, 0.3, 1] }}\n                  onClick={onEnter}\n                  className=\"group bg-primary text-black rounded-full flex items-center justify-between py-1.5 pl-6 pr-1.5 gap-6 hover:gap-8 transition-all duration-300 overflow-hidden\"\n                >\n                  <span className=\"font-medium text-sm sm:text-base whitespace-nowrap pt-[2px]\">Enter the Vault</span>\n                  <div className=\"bg-black rounded-full w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform duration-300\">\n                    <ArrowRight className=\"text-primary w-4 h-4 sm:w-5 sm:h-5\" />\n                  </div>\n                </motion.button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* SECTION 2: ABOUT */}\n      <section id=\"our-story\" className=\"bg-black py-24 md:py-32 px-4 md:px-6\">\n        <div className=\"bg-[#101010] rounded-[2rem] p-8 md:p-16 lg:p-24 max-w-7xl mx-auto flex flex-col items-center justify-center relative overflow-hidden text-center\">\n          <p className=\"text-primary text-[10px] sm:text-xs uppercase tracking-widest mb-12\">Cosmic exploration</p>\n          \n          <WordsPullUpMultiStyle \n            segments={[\n              { text: \"We are glyph,\" },\n              { text: \" seekers of meaning.\", className: \"font-serif italic text-white/90\" },\n              { text: \" We curate wisdom in typography, philosophy, and astral resonance.\" }\n            ]}\n            className=\"text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl max-w-4xl mx-auto leading-[0.95] sm:leading-[0.9] mb-16\"\n          />\n\n          <ScrollRevealText \n            text=\"Over the last era, we have worked with thinkers, astrologers, and designers globally to craft a sanctuary for the mind. Together, we have created an interactive library that earned acclaim among modern scholars and mystics alike.\"\n            className=\"text-[#DEDBC8] text-xs sm:text-sm md:text-base max-w-2xl mx-auto leading-relaxed\"\n          />\n        </div>\n      </section>\n\n      {/* SECTION 3: FEATURES */}\n      <section id=\"features\" className=\"min-h-screen bg-black relative py-20 px-4 md:px-6\">\n        <div className=\"absolute inset-0 bg-noise opacity-[0.15] pointer-events-none mix-blend-overlay\"></div>\n        \n        <div className=\"max-w-7xl mx-auto relative z-10\">\n          <div className=\"mb-16\">\n            <WordsPullUpMultiStyle \n              segments={[\n                { text: \"Curated experiences for the curious.\", className: \"block text-primary\" },\n                { text: \"Built for pure vision. Powered by focus.\", className: \"block text-gray-500 mt-2\" }\n              ]}\n              className=\"text-xl sm:text-2xl md:text-3xl lg:text-4xl font-normal !justify-start text-left\"\n            />\n          </div>\n\n          <div ref={featureRef} className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-2 md:gap-1\">\n            \n            {/* Card 1 */}\n            <motion.div \n              initial={{ opacity: 0, scale: 0.95 }}\n              animate={isFeatureInView ? { opacity: 1, scale: 1 } : { opacity: 0, scale: 0.95 }}\n              transition={{ duration: 0.8, delay: 0.15, ease: [0.22, 1, 0.36, 1] }}\n              className=\"relative h-[480px] rounded-3xl overflow-hidden group\"\n            >\n              <video\n                autoPlay\n                loop\n                muted\n                playsInline\n                className=\"absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000\"\n                src=\"https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260406_133058_0504132a-0cf3-4450-a370-8ea3b05c95d4.mp4\"\n              />\n              <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 to-transparent\"></div>\n              <div className=\"absolute bottom-6 left-6\">\n                <p className=\"text-[#E1E0CC] font-medium text-xl\">Your creative canvas.</p>\n              </div>\n            </motion.div>\n\n            {/* Card 2 */}\n            <FeatureCard \n              delay={0.3}\n              inView={isFeatureInView}\n              number=\"01\"\n              title=\"The Grand Vault.\"\n              icon=\"https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260405_171918_4a5edc79-d78f-4637-ac8b-53c43c220606.png&w=1280&q=85\"\n              items={[\n                \"Curated mystic and philosophical volumes\",\n                \"Advanced 3D reading experience\",\n                \"Progress tracking and bookmarks\",\n                \"Multi-device synchronization\"\n              ]}\n              onEnter={onEnter}\n            />\n\n            {/* Card 3 */}\n            <FeatureCard \n              delay={0.45}\n              inView={isFeatureInView}\n              number=\"02\"\n              title=\"Astral Insights.\"\n              icon=\"https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260405_171741_ed9845ab-f5b2-4018-8ce7-07cc01823522.png&w=1280&q=85\"\n              items={[\n                \"Daily harmonized horoscopes\",\n                \"Zodiac compatibility analysis\",\n                \"Chinese cosmic counterparts\"\n              ]}\n              onEnter={onEnter}\n            />\n\n            {/* Card 4 */}\n            <FeatureCard \n              delay={0.6}\n              inView={isFeatureInView}\n              number=\"03\"\n              title=\"Deep Immersion.\"\n              icon=\"https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260405_171809_f56666dc-c099-4778-ad82-9ad4f209567b.png&w=1280&q=85\"\n              items={[\n                \"Silenced notification systems\",\n                \"Ambient cosmic soundscapes\",\n                \"Adaptive dark mode rendering\"\n              ]}\n              onEnter={onEnter}\n            />\n\n          </div>\n        </div>\n      </section>\n    </div>\n  );\n}\n\nfunction FeatureCard({ delay, inView, number, title, icon, items, onEnter }: any) {\n  return (\n    <motion.div \n      initial={{ opacity: 0, scale: 0.95 }}\n      animate={inView ? { opacity: 1, scale: 1 } : { opacity: 0, scale: 0.95 }}\n      transition={{ duration: 0.8, delay, ease: [0.22, 1, 0.36, 1] }}\n      className=\"bg-[#212121] rounded-3xl p-6 lg:p-8 flex flex-col h-[480px]\"\n    >\n      <img src={icon} alt=\"Icon\" className=\"w-10 h-10 sm:w-12 sm:h-12 rounded object-cover mb-12 opacity-80\" />\n      \n      <div className=\"flex items-center gap-2 mb-6\">\n        <span className=\"text-gray-500 font-serif text-lg\">{number}</span>\n        <h3 className=\"text-xl font-medium text-primary\">{title}</h3>\n      </div>\n\n      <ul className=\"space-y-4 mb-auto\">\n        {items.map((item: string, i: number) => (\n          <li key={i} className=\"flex items-start gap-3\">\n            <Check className=\"w-4 h-4 text-primary shrink-0 mt-0.5\" />\n            <span className=\"text-gray-400 text-sm leading-snug\">{item}</span>\n          </li>\n        ))}\n      </ul>\n\n      <button onClick={onEnter} className=\"flex items-center gap-2 text-primary text-sm font-medium hover:text-white transition-colors group mt-6\">\n        Enter Library\n        <ArrowRight className=\"w-4 h-4 -rotate-45 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform\" />\n      </button>\n    </motion.div>\n  );\n}"
        replacement_content: "import React, { useRef } from \'react\';\nimport { motion, useInView } from \'motion/react\';\nimport { ArrowRight, Check, Sparkles, Library } from \'lucide-react\';\nimport { WordsPullUp, WordsPullUpMultiStyle, ScrollRevealText } from \'./AnimatedText\';\n\n// Ensure you import the image for the hero background\nimport cliffReaderHero from \'../assets/images/cliff_reader_hero_1779620166562.png\';\n\ninterface LandingPageProps {\n  onEnterLibrary: () => void;\n  onEnterHoroscope: () => void;\n}\n\nexport default function LandingPage({ onEnterLibrary, onEnterHoroscope }: LandingPageProps) {\n  const featureRef = useRef(null);\n  const isFeatureInView = useInView(featureRef, { once: true, margin: \"-100px\" });\n\n  return (\n    <div className=\"bg-black min-h-screen text-primary selection:bg-primary/20\">\n      {/* SECTION 1: HERO */}\n      <section className=\"h-screen p-4 md:p-6\">\n        <div className=\"relative w-full h-full rounded-2xl md:rounded-[2rem] overflow-hidden bg-black isolation\">\n          {/* Background Image replaces video */}\n          <img\n            className=\"absolute inset-0 w-full h-full object-cover opacity-80\"\n            src={cliffReaderHero}\n            alt=\"Cinematic cliff reader\"\n          />\n          {/* Overlays */}\n          <div className=\"absolute inset-0 bg-gradient-to-t from-black via-black/20 to-black/60\"></div>\n\n          {/* Navbar */}\n          <div className=\"absolute top-0 left-1/2 -translate-x-1/2 bg-black rounded-b-2xl md:rounded-b-3xl px-4 py-3 md:px-8 flex items-center justify-center gap-3 sm:gap-6 md:gap-12 lg:gap-14 z-20\">\n            {[\'Our story\', \'Books\', \'Insights\', \'Programs\', \'Inquiries\'].map((item) => (\n              <a\n                key={item}\n                href={`#${item.toLowerCase().replace(\' \', \'-\')}`}\n                className=\"text-[10px] sm:text-xs md:text-sm whitespace-nowrap transition-colors\"\n                style={{ color: \'rgba(225, 224, 204, 0.8)\' }}\n                onMouseEnter={(e) => e.currentTarget.style.color = \'#E1E0CC\'}\n                onMouseLeave={(e) => e.currentTarget.style.color = \'rgba(225, 224, 204, 0.8)\'}\n              >\n                {item}\n              </a>\n            ))}\n          </div>\n\n          {/* Hero Content */}\n          <div className=\"absolute bottom-0 left-0 right-0 p-6 md:p-12 lg:p-16 z-20\">\n            <div className=\"grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-0 items-end\">\n              <div className=\"md:col-span-6 lg:col-span-7\">\n                <WordsPullUp \n                  text=\"glyph\" \n                  showAsterisk={true} \n                  className=\"text-[26vw] sm:text-[24vw] md:text-[22vw] lg:text-[20vw] xl:text-[19vw] 2xl:text-[20vw] font-medium leading-[0.85] tracking-[-0.07em] lowercase\" \n                  style={{ color: \'#E1E0CC\' }}\n                />\n              </div>\n              <div className=\"md:col-span-6 lg:col-span-5 flex flex-col items-start gap-8 md:pb-6\">\n                <motion.p \n                  initial={{ opacity: 0, y: 20 }}\n                  animate={{ opacity: 1, y: 0 }}\n                  transition={{ delay: 0.5, duration: 0.8, ease: [0.16, 1, 0.3, 1] }}\n                  className=\"text-primary/70 text-xs sm:text-sm md:text-base leading-[1.4]\"\n                >\n                  glyph. is a worldwide network of readers, philosophers and storytellers bound not by place, status or labels but by passion and hunger to unlock potential through our curated perspectives.\n                </motion.p>\n                \n                <motion.div \n                  initial={{ opacity: 0, y: 20 }}\n                  animate={{ opacity: 1, y: 0 }}\n                  transition={{ delay: 0.7, duration: 0.8, ease: [0.16, 1, 0.3, 1] }}\n                  className=\"flex flex-col sm:flex-row gap-4 w-full\"\n                >\n                  <button \n                    onClick={onEnterHoroscope}\n                    className=\"flex-1 group bg-black/50 backdrop-blur-md border border-primary/20 text-primary rounded-full flex items-center justify-between py-2 pl-6 pr-2 gap-4 hover:bg-black/70 hover:border-primary/40 transition-all duration-300 overflow-hidden\"\n                  >\n                    <div className=\"flex items-center gap-3\">\n                      <Sparkles className=\"w-4 h-4 text-primary/70\" />\n                      <span className=\"font-medium text-sm whitespace-nowrap\">Deep Insights</span>\n                    </div>\n                    <div className=\"bg-primary/10 rounded-full w-8 h-8 flex items-center justify-center shrink-0 group-hover:scale-110 group-hover:bg-primary/20 transition-all duration-300\">\n                      <ArrowRight className=\"text-primary w-4 h-4 -rotate-45\" />\n                    </div>\n                  </button>\n\n                  <button \n                    onClick={onEnterLibrary}\n                    className=\"flex-1 group bg-primary text-black rounded-full flex items-center justify-between py-2 pl-6 pr-2 gap-4 hover:bg-primary/90 transition-all duration-300 overflow-hidden shadow-[0_0_30px_rgba(222,219,200,0.15)] hover:shadow-[0_0_40px_rgba(222,219,200,0.25)]\"\n                  >\n                    <div className=\"flex items-center gap-3\">\n                      <Library className=\"w-4 h-4\" />\n                      <span className=\"font-medium text-sm whitespace-nowrap\">The Cliff Gallery</span>\n                    </div>\n                    <div className=\"bg-black rounded-full w-8 h-8 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform duration-300\">\n                       <ArrowRight className=\"text-primary w-4 h-4\" />\n                    </div>\n                  </button>\n                </motion.div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* SECTION 2: ABOUT */}\n      <section id=\"our-story\" className=\"bg-black py-24 md:py-32 px-4 md:px-6\">\n        <div className=\"bg-[#101010] rounded-[2rem] p-8 md:p-16 lg:p-24 max-w-7xl mx-auto flex flex-col items-center justify-center relative overflow-hidden text-center\">\n          <p className=\"text-primary text-[10px] sm:text-xs uppercase tracking-widest mb-12\">Cosmic exploration</p>\n          \n          <WordsPullUpMultiStyle \n            segments={[\n              { text: \"We are glyph,\" },\n              { text: \" seekers of meaning.\", className: \"font-serif italic text-white/90\" },\n              { text: \" We curate wisdom in typography, philosophy, and astral resonance.\" }\n            ]}\n            className=\"text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl max-w-4xl mx-auto leading-[0.95] sm:leading-[0.9] mb-16\"\n          />\n\n          <ScrollRevealText \n            text=\"Over the last era, we have worked with thinkers, astrologers, and designers globally to craft a sanctuary for the mind. Together, we have created an interactive library that earned acclaim among modern scholars and mystics alike.\"\n            className=\"text-[#DEDBC8] text-xs sm:text-sm md:text-base max-w-2xl mx-auto leading-relaxed\"\n          />\n        </div>\n      </section>\n\n      {/* SECTION 3: FEATURES */}\n      <section id=\"features\" className=\"min-h-screen bg-black relative py-20 px-4 md:px-6\">\n        <div className=\"absolute inset-0 bg-noise opacity-[0.15] pointer-events-none mix-blend-overlay\"></div>\n        \n        <div className=\"max-w-7xl mx-auto relative z-10\">\n          <div className=\"mb-16\">\n            <WordsPullUpMultiStyle \n              segments={[\n                { text: \"Curated experiences for the curious.\", className: \"block text-primary\" },\n                { text: \"Built for pure vision. Powered by focus.\", className: \"block text-gray-500 mt-2\" }\n              ]}\n              className=\"text-xl sm:text-2xl md:text-3xl lg:text-4xl font-normal !justify-start text-left\"\n            />\n          </div>\n\n          <div ref={featureRef} className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-2 md:gap-1\">\n            \n            {/* Card 1 */}\n            <motion.div \n              initial={{ opacity: 0, scale: 0.95 }}\n              animate={isFeatureInView ? { opacity: 1, scale: 1 } : { opacity: 0, scale: 0.95 }}\n              transition={{ duration: 0.8, delay: 0.15, ease: [0.22, 1, 0.36, 1] }}\n              className=\"relative h-[480px] rounded-3xl overflow-hidden group\"\n            >\n              <img\n                className=\"absolute inset-0 w-full h-full object-cover opacity-80 group-hover:scale-105 transition-transform duration-1000 grayscale opacity-80 mix-blend-lighten\"\n                src={cliffReaderHero}\n                alt=\"Your creative canvas\"\n              />\n              <div className=\"absolute inset-0 bg-gradient-to-t from-[#101010] to-transparent\"></div>\n              <div className=\"absolute bottom-6 left-6\">\n                <p className=\"text-[#E1E0CC] font-medium text-xl\">Your creative canvas.</p>\n              </div>\n            </motion.div>\n\n            {/* Card 2 */}\n            <FeatureCard \n              delay={0.3}\n              inView={isFeatureInView}\n              number=\"01\"\n              title=\"The Cliff Gallery.\"\n              icon=\"https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260405_171918_4a5edc79-d78f-4637-ac8b-53c43c220606.png&w=1280&q=85\"\n              items={[\n                \"Curated mystic and philosophical volumes\",\n                \"Advanced 3D reading experience\",\n                \"Progress tracking and bookmarks\",\n                \"Save books to your personal gallery\"\n              ]}\n              onEnter={onEnterLibrary}\n            />\n\n            {/* Card 3 */}\n            <FeatureCard \n              delay={0.45}\n              inView={isFeatureInView}\n              number=\"02\"\n              title=\"Astral Insights.\"\n              icon=\"https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260405_171741_ed9845ab-f5b2-4018-8ce7-07cc01823522.png&w=1280&q=85\"\n              items={[\n                \"Daily harmonized horoscopes\",\n                \"Zodiac compatibility analysis\",\n                \"Chinese cosmic counterparts\"\n              ]}\n              onEnter={onEnterHoroscope}\n            />\n\n            {/* Card 4 */}\n            <FeatureCard \n              delay={0.6}\n              inView={isFeatureInView}\n              number=\"03\"\n              title=\"Deep Immersion.\"\n              icon=\"https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260405_171809_f56666dc-c099-4778-ad82-9ad4f209567b.png&w=1280&q=85\"\n              items={[\n                \"Silenced notification systems\",\n                \"Ambient cosmic soundscapes\",\n                \"Adaptive dark mode rendering\"\n              ]}\n              onEnter={onEnterLibrary}\n            />\n\n          </div>\n        </div>\n      </section>\n    </div>\n  );\n}\n\nfunction FeatureCard({ delay, inView, number, title, icon, items, onEnter }: any) {\n  return (\n    <motion.div \n      initial={{ opacity: 0, scale: 0.95 }}\n      animate={inView ? { opacity: 1, scale: 1 } : { opacity: 0, scale: 0.95 }}\n      transition={{ duration: 0.8, delay, ease: [0.22, 1, 0.36, 1] }}\n      className=\"bg-[#212121] rounded-3xl p-6 lg:p-8 flex flex-col h-[480px]\"\n    >\n      <img src={icon} alt=\"Icon\" className=\"w-10 h-10 sm:w-12 sm:h-12 rounded object-cover mb-12 opacity-80\" />\n      \n      <div className=\"flex items-center gap-2 mb-6\">\n        <span className=\"text-gray-500 font-serif text-lg\">{number}</span>\n        <h3 className=\"text-xl font-medium text-primary\">{title}</h3>\n      </div>\n\n      <ul className=\"space-y-4 mb-auto\">\n        {items.map((item: string, i: number) => (\n          <li key={i} className=\"flex items-start gap-3\">\n            <Check className=\"w-4 h-4 text-primary shrink-0 mt-0.5\" />\n            <span className=\"text-gray-400 text-sm leading-snug\">{item}</span>\n          </li>\n        ))}\n      </ul>\n\n      <button onClick={onEnter} className=\"flex items-center gap-2 text-primary text-sm font-medium hover:text-white transition-colors group mt-6\">\n        Enter Module\n        <ArrowRight className=\"w-4 h-4 -rotate-45 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform\" />\n      </button>\n    </motion.div>\n  );\n}"
      }
      num_matches: 1
    }
  }
