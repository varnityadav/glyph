  file_change {
    absolute_path_uri: "file:///src/components/AnimatedText.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useRef } from \'react\';\nimport { motion, useInView, useScroll, useTransform } from \'motion/react\';\n\ninterface WordsPullUpProps {\n  text: string;\n  className?: string;\n  showAsterisk?: boolean;\n}\n\nexport function WordsPullUp({ text, className = \"\", showAsterisk = false }: WordsPullUpProps) {\n  const ref = useRef(null);\n  const isInView = useInView(ref, { once: true });\n  const words = text.split(\' \');\n\n  return (\n    <div ref={ref} className={`inline-flex flex-wrap ${className}`}>\n      {words.map((word, i) => {\n        const isLastWord = i === words.length - 1;\n        return (\n          <div key={i} className=\"overflow-hidden inline-block mr-[0.25em]\">\n            <motion.span\n              className=\"inline-block relative\"\n              initial={{ y: \"100%\" }}\n              animate={isInView ? { y: 0 } : { y: \"100%\" }}\n              transition={{ delay: i * 0.08, duration: 0.6, ease: [0.16, 1, 0.3, 1] }}\n            >\n              {word}\n              {showAsterisk && isLastWord && (\n                <span className=\"absolute top-[0.65em] -right-[0.3em] text-[0.31em]\">*</span>\n              )}\n            </motion.span>\n          </div>\n        );\n      })}\n    </div>\n  );\n}\n\ninterface Segment {\n  text: string;\n  className?: string;\n}\n\ninterface WordsPullUpMultiStyleProps {\n  segments: Segment[];\n  className?: string;\n}\n\nexport function WordsPullUpMultiStyle({ segments, className = \"\" }: WordsPullUpMultiStyleProps) {\n  const ref = useRef(null);\n  const isInView = useInView(ref, { once: true });\n  \n  let globalWordIndex = 0;\n\n  return (\n    <div ref={ref} className={`inline-flex flex-wrap justify-center ${className}`}>\n      {segments.map((segment, segIdx) => {\n        const words = segment.text.split(\' \');\n        \n        return words.map((word, wordIdx) => {\n          const currentIndex = globalWordIndex++;\n          return (\n            <div key={`${segIdx}-${wordIdx}`} className=\"overflow-hidden inline-block mr-[0.25em]\">\n              <motion.span\n                className={`inline-block ${segment.className || \'\'}`}\n                initial={{ y: \"100%\" }}\n                animate={isInView ? { y: 0 } : { y: \"100%\" }}\n                transition={{ delay: currentIndex * 0.08, duration: 0.6, ease: [0.16, 1, 0.3, 1] }}\n              >\n                {word}\n              </motion.span>\n            </div>\n          );\n        });\n      })}\n    </div>\n  );\n}\n\ninterface AnimatedLetterProps {\n  children: string;\n  progress: number;\n  index: number;\n  total: number;\n}\n\nexport function AnimatedLetter({ children, progress, index, total }: AnimatedLetterProps) {\n  const charProgress = index / total;\n  const start = Math.max(0, charProgress - 0.1);\n  const end = Math.min(1, charProgress + 0.05);\n\n  const opacity = progress > end ? 1 : progress < start ? 0.2 : 0.2 + (0.8 * ((progress - start) / (end - start)));\n\n  return (\n    <span style={{ opacity, transition: \'opacity 0.1s linear\' }}>\n      {children}\n    </span>\n  );\n}\n\ninterface ScrollRevealTextProps {\n  text: string;\n  className?: string;\n}\n\nexport function ScrollRevealText({ text, className = \"\" }: ScrollRevealTextProps) {\n  const container = useRef(null);\n  const { scrollYProgress } = useScroll({\n    target: container,\n    offset: [\'start 0.8\', \'end 0.2\']\n  });\n\n  // Calculate actual progress state\n  const [progress, setProgress] = React.useState(0);\n  \n  React.useEffect(() => {\n    return scrollYProgress.on(\'change\', (v) => setProgress(v));\n  }, [scrollYProgress]);\n\n  const chars = text.split(\'\');\n  \n  return (\n    <p ref={container} className={className}>\n      {chars.map((char, i) => (\n        <AnimatedLetter key={i} progress={progress} index={i} total={chars.length}>\n          {char}\n        </AnimatedLetter>\n      ))}\n    </p>\n  );\n}\n"
    }
