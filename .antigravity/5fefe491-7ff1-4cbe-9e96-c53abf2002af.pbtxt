    instruction: "Add ambient audio toggle, bookmark/summary features, and make the UI match the cinematic cliff style"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState, useMemo } from \'react\';\nimport CelestialBackground from \'./components/CelestialBackground\';\nimport Book3D from \'./components/Book3D\';\nimport ReaderOverlay from \'./components/ReaderOverlay\';\nimport HoroscopePanel from \'./components/HoroscopePanel\';\nimport { books, categories, Book } from \'./data\';\nimport { Menu, ArrowRight, Library, Sparkles, Search, ArrowLeft } from \'lucide-react\';\nimport LandingPage from \'./components/LandingPage\';\n\nexport default function App() {\n  const [view, setView] = useState<\'landing\' | \'app\'>(\'landing\');\n\n  if (view === \'landing\') {\n    return <LandingPage onEnter={() => setView(\'app\')} />;\n  }\n\n  return <AppContent onExit={() => setView(\'landing\')} />;\n}\n\nfunction AppContent({ onExit }: { onExit: () => void }) {\n  const [activeCategory, setActiveCategory] = useState<string>(categories[0]);\n  const [activeBook, setActiveBook] = useState<Book | null>(books.find(b => b.category === categories[0]) || null);\n  const [isReading, setIsReading] = useState(false);\n  const [showHoroscope, setShowHoroscope] = useState(false);\n  const [searchQuery, setSearchQuery] = useState(\'\');\n\n  const filteredBooks = useMemo(() => {\n    if (searchQuery.trim()) {\n      const q = searchQuery.toLowerCase();\n      return books.filter(b => b.title.toLowerCase().includes(q) || b.author.toLowerCase().includes(q));\n    }\n    return books.filter(b => b.category === activeCategory);\n  }, [searchQuery, activeCategory]);\n\n  const handleCategorySelect = (category: string) => {\n    setActiveCategory(category);\n    const bookInCat = books.find(b => b.category === category);\n    if (bookInCat) setActiveBook(bookInCat);\n  };\n\n  return (\n    <div className=\"relative min-h-screen bg-[#111116] text-gray-100 font-sans selection:bg-lavender-300/30 overflow-hidden\">\n      <CelestialBackground />\n\n      {/* Main Layout Container */}\n      <div className=\"relative z-10 flex flex-col lg:flex-row min-h-screen p-4 lg:p-6 gap-4 lg:gap-6\">\n        \n        {/* LEFT PANEL: Library Navigation */}\n        <div className=\"w-full lg:w-[45%] flex flex-col gap-4 lg:gap-6\">\n          \n          {/* Header */}\n          <div className=\"liquid-glass-strong rounded-[2rem] p-6 lg:px-8 flex justify-between items-center z-20 border border-white/5\">\n            <div className=\"flex items-center gap-4\">\n              <button onClick={onExit} className=\"w-10 h-10 liquid-glass rounded-full flex items-center justify-center text-white/80 hover:text-white transition-all border border-white/10 shrink-0\">\n                <ArrowLeft className=\"w-4 h-4\" />\n              </button>\n              <h1 className=\"font-serif text-3xl text-white font-medium lowercase tracking-tight hidden sm:block\">glyph.</h1>\n            </div>\n            <div className=\"flex items-center gap-4\">\n               <div className=\"relative hidden md:block\">\n                 <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-white/50\" />\n                 <input \n                   type=\"text\"\n                   placeholder=\"Search...\"\n                   value={searchQuery}\n                   onChange={(e) => setSearchQuery(e.target.value)}\n                   className=\"pl-9 pr-4 py-2 bg-white/5 border border-white/10 rounded-full text-sm text-white placeholder:text-white/30 focus:outline-none focus:bg-white/10 transition-all w-48 focus:w-64\"\n                 />\n               </div>\n               <button className=\"w-10 h-10 liquid-glass rounded-full flex items-center justify-center text-white/80 hover:text-white transition-all border border-white/10\">\n                 <Menu className=\"w-4 h-4\" />\n               </button>\n            </div>\n          </div>\n\n          {/* Library Content Area */}\n          <div className=\"flex-1 liquid-glass-strong rounded-[2rem] p-6 lg:p-8 flex flex-col border border-white/5 relative\">\n            <div className=\"flex-1 flex flex-col animate-in fade-in duration-500\">\n              <p className=\"text-white/60 mb-8 text-lg font-light leading-relaxed max-w-sm\">\n                A serene collection of thoughts, stories, and cosmic wisdom formatted for contemplation.\n              </p>\n\n              {/* Categories */}\n              <div className=\"mb-8\">\n                <p className=\"text-[10px] uppercase tracking-[0.2em] text-white/40 mb-4 font-medium flex items-center gap-2\">\n                  <Library className=\"w-3 h-3\" /> Select Topic\n                </p>\n                <div className=\"flex flex-wrap gap-2\">\n                  {categories.map((cat) => (\n                    <button\n                      key={cat}\n                      onClick={() => handleCategorySelect(cat)}\n                      className={`px-5 py-2.5 rounded-full text-xs tracking-widest uppercase transition-all duration-300 ${\n                        activeCategory === cat \n                        ? \'bg-white/10 text-white border border-white/20\' \n                        : \'bg-transparent text-white/50 hover:bg-white/5 hover:text-white\'\n                      }`}\n                    >\n                      {cat}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Book List */}\n              <div className=\"flex-1 min-h-[200px] overflow-y-auto scrollbar-hide pb-10\">\n                 <div className=\"space-y-3 pr-2\">\n                    {filteredBooks.map((book) => (\n                      <div \n                        key={book.id}\n                        onClick={() => setActiveBook(book)}\n                        className={`p-4 rounded-[1.25rem] cursor-pointer transition-all duration-300 flex items-center gap-5 ${\n                          activeBook?.id === book.id\n                          ? \'liquid-glass border border-white/10 shadow-[0_4px_20px_rgba(0,0,0,0.2)]\'\n                          : \'hover:bg-white/5 border border-transparent\'\n                        }`}\n                      >\n                        <div className={`w-12 h-16 rounded shadow-lg ${book.coverColor} border border-white/10 shrink-0 relative overflow-hidden`}>\n                           <div className=\"absolute inset-0 bg-gradient-to-br from-white/20 to-transparent mix-blend-overlay\"></div>\n                        </div>\n                        <div className=\"flex-1\">\n                          <h4 className=\"font-serif text-white text-lg leading-tight mb-1\">{book.title}</h4>\n                          <p className=\"font-sans text-[10px] text-white/50 uppercase tracking-[0.2em]\">{book.author}</p>\n                        </div>\n                        <div className={`w-8 h-8 rounded-full flex items-center justify-center transition-opacity ${activeBook?.id === book.id ? \'opacity-100 bg-white/10\' : \'opacity-0\'}`}>\n                           <ArrowRight className=\"w-4 h-4 text-white\" />\n                        </div>\n                      </div>\n                    ))}\n                    {filteredBooks.length === 0 && (\n                       <p className=\"text-white/40 text-sm italic py-4\">No volumes available in this realm.</p>\n                    )}\n                 </div>\n              </div>\n            </div>\n\n            {/* Bottom Actions / Horoscope Button */}\n            <div className=\"mt-4 pt-6 border-t border-white/10\">\n              <button \n                onClick={() => setShowHoroscope(true)}\n                className=\"w-full flex items-center justify-between p-4 rounded-2xl liquid-glass border border-white/5 hover:bg-white/5 transition-colors group\"\n              >\n                <div className=\"flex items-center gap-3 text-left\">\n                  <div className=\"w-10 h-10 rounded-full bg-white/5 flex items-center justify-center border border-white/10\">\n                    <Sparkles className=\"w-4 h-4 text-lavender-300\" />\n                  </div>\n                  <div>\n                    <h4 className=\"font-medium text-white/90 text-sm mb-0.5\">Cosmic Highlights</h4>\n                    <p className=\"text-[10px] uppercase tracking-widest text-white/40\">View your planetary alignments</p>\n                  </div>\n                </div>\n                <ArrowRight className=\"w-4 h-4 text-white/30 group-hover:text-white/70 transition-colors\" />\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* RIGHT PANEL: 3D Stage (Desktop) */}\n        <div className=\"hidden lg:flex flex-col relative flex-1 liquid-glass-strong rounded-[2rem] border border-white/5 p-8\">\n           {/* Central Dynamic Stage */}\n           <div className=\"flex-1 flex flex-col items-center justify-center relative\">\n              <div className=\"absolute inset-x-20 inset-y-10 rounded-[3rem] border border-white/[0.02] bg-gradient-to-b from-white/[0.01] to-transparent pointer-events-none\" />\n              \n              <div className=\"h-[450px] w-full flex items-center justify-center mb-12 animate-in fade-in zoom-in duration-700\">\n                 <Book3D book={activeBook} onClick={() => {}} />\n              </div>\n\n              {activeBook && (\n                <div className=\"flex flex-col items-center liquid-glass p-8 rounded-[2rem] border border-white/5 max-w-sm w-full animate-in slide-in-from-bottom-8 duration-500\">\n                  <h3 className=\"font-serif text-white text-2xl mb-2 text-center\">{activeBook.title}</h3>\n                  <p className=\"font-sans text-[10px] text-white/50 uppercase tracking-[0.2em] mb-8 text-center\">{activeBook.author}</p>\n                  \n                  <button \n                    onClick={() => setIsReading(true)}\n                    className=\"group relative flex items-center justify-between w-full bg-white/10 border border-white/20 text-white py-4 px-6 rounded-full font-medium hover:bg-white/20 hover:scale-[1.02] active:scale-95 transition-all outline-none\"\n                  >\n                    <span className=\"uppercase tracking-widest text-xs\">Begin Reading</span>\n                    <span className=\"w-8 h-8 rounded-full bg-white text-black flex items-center justify-center group-hover:bg-lavender-100 transition-colors\">\n                      <ArrowRight className=\"w-4 h-4\" />\n                    </span>\n                  </button>\n                </div>\n              )}\n           </div>\n        </div>\n      </div>\n\n      {/* Reader Modal */}\n      <ReaderOverlay \n        book={isReading ? activeBook : null} \n        onClose={() => setIsReading(false)} \n      />\n\n      {/* Horoscope Modal */}\n      <HoroscopePanel isOpen={showHoroscope} onClose={() => setShowHoroscope(false)} />\n    </div>\n  );\n}"
        replacement_content: "import React, { useState, useMemo, useRef, useEffect } from \'react\';\nimport CelestialBackground from \'./components/CelestialBackground\';\nimport Book3D from \'./components/Book3D\';\nimport ReaderOverlay from \'./components/ReaderOverlay\';\nimport HoroscopePanel from \'./components/HoroscopePanel\';\nimport { books, categories, Book } from \'./data\';\nimport { Menu, ArrowRight, Library, Sparkles, Search, ArrowLeft, Play, Pause, Bookmark } from \'lucide-react\';\nimport LandingPage from \'./components/LandingPage\';\n\nexport default function App() {\n  const [view, setView] = useState<\'landing\' | \'library\' | \'horoscope\'>(\'landing\');\n\n  if (view === \'landing\') {\n    return (\n      <LandingPage \n        onEnterLibrary={() => setView(\'library\')} \n        onEnterHoroscope={() => setView(\'horoscope\')} \n      />\n    );\n  }\n\n  return (\n    <>\n      <AppContent onExit={() => setView(\'landing\')} view={view} setView={setView} />\n    </>\n  );\n}\n\nfunction AppContent({ onExit, view, setView }: { onExit: () => void, view: \'library\' | \'horoscope\', setView: (v: \'library\' | \'horoscope\') => void }) {\n  const [activeCategory, setActiveCategory] = useState<string>(categories[0]);\n  const [activeBook, setActiveBook] = useState<Book | null>(books.find(b => b.category === categories[0]) || null);\n  const [isReading, setIsReading] = useState(false);\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  \n  // Ambient Audio State\n  const [isAudioPlaying, setIsAudioPlaying] = useState(false);\n  const audioRef = useRef<HTMLAudioElement | null>(null);\n\n  // Gallery saved books\n  const [savedBooks, setSavedBooks] = useState<Set<string>>(new Set());\n\n  useEffect(() => {\n    if (audioRef.current) {\n      if (isAudioPlaying) {\n        audioRef.current.play().catch(() => setIsAudioPlaying(false));\n      } else {\n        audioRef.current.pause();\n      }\n    }\n  }, [isAudioPlaying]);\n\n  const filteredBooks = useMemo(() => {\n    if (searchQuery.trim()) {\n      const q = searchQuery.toLowerCase();\n      return books.filter(b => b.title.toLowerCase().includes(q) || b.author.toLowerCase().includes(q) || b.category.toLowerCase().includes(q));\n    }\n    return books.filter(b => b.category === activeCategory);\n  }, [searchQuery, activeCategory]);\n\n  const handleCategorySelect = (category: string) => {\n    setActiveCategory(category);\n    const bookInCat = books.find(b => b.category === category);\n    if (bookInCat) setActiveBook(bookInCat);\n  };\n\n  const toggleSaveBook = (e: React.MouseEvent, bookId: string) => {\n    e.stopPropagation();\n    setSavedBooks(prev => {\n      const next = new Set(prev);\n      if (next.has(bookId)) next.delete(bookId);\n      else next.add(bookId);\n      return next;\n    });\n  };\n\n  return (\n    <div className=\"relative min-h-screen bg-black text-[#DEDBC8] font-sans selection:bg-[#DEDBC8]/20 overflow-hidden\">\n      <CelestialBackground />\n      {/* Background Noise to match landing */}\n      <div className=\"absolute inset-0 bg-noise opacity-[0.1] pointer-events-none mix-blend-overlay z-0\"></div>\n\n      {/* Ambient Audio Element (Google Sounds) */}\n      <audio \n        ref={audioRef} \n        src=\"https://actions.google.com/sounds/v1/science_fiction/space_room_with_hum.ogg\" \n        loop\n      />\n\n      {/* Main Layout Container */}\n      <div className=\"relative z-10 flex flex-col lg:flex-row min-h-screen p-4 lg:p-6 gap-4 lg:gap-6 max-w-[1600px] mx-auto\">\n        \n        {/* LEFT PANEL: Library Navigation */}\n        <div className=\"w-full lg:w-[45%] flex flex-col gap-4 lg:gap-6\">\n          \n          {/* Header */}\n          <div className=\"bg-[#101010]/80 backdrop-blur-xl rounded-[2rem] p-6 lg:px-8 flex justify-between items-center border border-white/5 shadow-2xl\">\n            <div className=\"flex items-center gap-4\">\n              <button onClick={onExit} className=\"w-10 h-10 bg-white/5 rounded-full flex items-center justify-center text-white/50 hover:text-white transition-all border border-white/10 shrink-0 hover:bg-white/10\">\n                <ArrowLeft className=\"w-4 h-4\" />\n              </button>\n              <h1 className=\"font-serif text-3xl text-[#E1E0CC] font-medium lowercase tracking-tight hidden sm:block\">glyph.</h1>\n            </div>\n            <div className=\"flex items-center gap-3\">\n               <button \n                 onClick={() => setIsAudioPlaying(!isAudioPlaying)}\n                 className={`w-10 h-10 rounded-full flex items-center justify-center transition-all border ${isAudioPlaying ? \'bg-[#DEDBC8]/10 border-[#DEDBC8]/20 text-[#DEDBC8]\' : \'bg-white/5 border-white/10 text-white/50 hover:text-white\'}`}\n                 title=\"Toggle Ambient Cosmic Audio\"\n               >\n                 {isAudioPlaying ? <Pause className=\"w-4 h-4\" /> : <Play className=\"w-4 h-4\" />}\n               </button>\n\n               <div className=\"relative hidden md:block\">\n                 <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[#DEDBC8]/50\" />\n                 <input \n                   type=\"text\"\n                   placeholder=\"Search gallery...\"\n                   value={searchQuery}\n                   onChange={(e) => setSearchQuery(e.target.value)}\n                   className=\"pl-9 pr-4 py-2 bg-white/5 border border-white/10 rounded-full text-sm text-[#DEDBC8] placeholder:text-[#DEDBC8]/30 focus:outline-none focus:bg-white/10 transition-all w-48 focus:w-64\"\n                 />\n               </div>\n               <button className=\"w-10 h-10 bg-white/5 rounded-full flex items-center justify-center text-white/50 hover:text-white transition-all border border-white/10 hover:bg-white/10\">\n                 <Menu className=\"w-4 h-4\" />\n               </button>\n            </div>\n          </div>\n\n          {/* Library Content Area */}\n          <div className=\"flex-1 bg-[#101010]/70 backdrop-blur-xl rounded-[2rem] p-6 lg:p-8 flex flex-col border border-[#DEDBC8]/5 relative shadow-inner shadow-[#DEDBC8]/5\">\n            <div className=\"flex-1 flex flex-col animate-in fade-in duration-500\">\n              <p className=\"text-[#DEDBC8]/60 mb-8 text-lg font-light leading-relaxed max-w-sm font-sans\">\n                A serene collection of thoughts, stories, and cosmic wisdom curated for the quiet moments on the edge of the world.\n              </p>\n\n              {/* Categories */}\n              <div className=\"mb-8\">\n                <p className=\"text-[10px] uppercase tracking-[0.2em] text-[#DEDBC8]/40 mb-4 font-medium flex items-center gap-2\">\n                  <Library className=\"w-3 h-3\" /> The Cliff Gallery\n                </p>\n                <div className=\"flex flex-wrap gap-2\">\n                  {categories.map((cat) => (\n                    <button\n                      key={cat}\n                      onClick={() => handleCategorySelect(cat)}\n                      className={`px-5 py-2.5 rounded-full text-xs tracking-widest uppercase transition-all duration-300 ${\n                        activeCategory === cat \n                        ? \'bg-[#DEDBC8] text-black font-semibold\' \n                        : \'bg-transparent text-[#DEDBC8]/50 hover:bg-white/10 hover:text-[#DEDBC8]\'\n                      }`}\n                    >\n                      {cat}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Book List */}\n              <div className=\"flex-1 min-h-[200px] overflow-y-auto scrollbar-hide pb-10\">\n                 <div className=\"space-y-3 pr-2\">\n                    {filteredBooks.map((book) => {\n                      const isSaved = savedBooks.has(book.id);\n                      return (\n                        <div \n                          key={book.id}\n                          onClick={() => setActiveBook(book)}\n                          className={`p-4 rounded-[1.25rem] cursor-pointer transition-all duration-300 flex items-center gap-5 ${\n                            activeBook?.id === book.id\n                            ? \'bg-white/10 border border-[#DEDBC8]/20 shadow-[0_4px_20px_rgba(0,0,0,0.3)]\'\n                            : \'hover:bg-white/5 border border-transparent\'\n                          }`}\n                        >\n                          <div className={`w-12 h-16 rounded shadow-lg ${book.coverColor} border border-white/10 shrink-0 relative overflow-hidden flex items-center justify-center`}>\n                             <div className=\"absolute inset-0 bg-gradient-to-br from-white/20 to-transparent mix-blend-overlay\"></div>\n                             {isSaved && <Bookmark className=\"w-3 h-3 text-[#DEDBC8] absolute top-1 right-1 opacity-70 fill-current\" />}\n                          </div>\n                          <div className=\"flex-1\">\n                            <h4 className=\"font-serif text-[#DEDBC8] text-lg leading-tight mb-1\">{book.title}</h4>\n                            <div className=\"flex items-center gap-2\">\n                              <p className=\"font-sans text-[10px] text-[#DEDBC8]/50 uppercase tracking-[0.2em]\">{book.author}</p>\n                              {activeBook?.id === book.id && (\n                                <>\n                                  <span className=\"w-1 h-1 rounded-full bg-[#DEDBC8]/30\"></span>\n                                  <p className=\"font-sans text-[10px] text-[#DEDBC8]/50\">{book.readTimeMn} min</p>\n                                </>\n                              )}\n                            </div>\n                          </div>\n                          \n                          <button \n                            onClick={(e) => toggleSaveBook(e, book.id)}\n                            className=\"w-8 h-8 rounded-full flex items-center justify-center transition-colors text-[#DEDBC8]/30 hover:text-[#DEDBC8] hover:bg-white/10\"\n                          >\n                             <Bookmark className={`w-4 h-4 ${isSaved ? \'fill-current text-[#DEDBC8]\' : \'\'}`} />\n                          </button>\n                        </div>\n                      );\n                    })}\n                    {filteredBooks.length === 0 && (\n                       <p className=\"text-[#DEDBC8]/40 text-sm italic py-4\">No volumes available matching your search.</p>\n                    )}\n                 </div>\n              </div>\n            </div>\n\n            {/* Bottom Actions / Horoscope Button */}\n            <div className=\"mt-4 pt-6 border-t border-white/10 relative z-10\">\n              <button \n                onClick={() => setView(\'horoscope\')}\n                className=\"w-full flex items-center justify-between p-4 rounded-2xl bg-black/40 border border-[#DEDBC8]/10 hover:border-[#DEDBC8]/30 transition-all group\"\n              >\n                <div className=\"flex items-center gap-4 text-left\">\n                  <div className=\"w-10 h-10 rounded-full bg-[#DEDBC8]/10 flex items-center justify-center border border-[#DEDBC8]/20 group-hover:scale-110 transition-transform\">\n                    <Sparkles className=\"w-4 h-4 text-[#DEDBC8]\" />\n                  </div>\n                  <div>\n                    <h4 className=\"font-medium text-[#DEDBC8] text-sm mb-0.5\">Deep Insights</h4>\n                    <p className=\"text-[10px] uppercase tracking-widest text-[#DEDBC8]/40\">Explore today\'s celestial horoscopes</p>\n                  </div>\n                </div>\n                <ArrowRight className=\"w-4 h-4 text-[#DEDBC8]/30 group-hover:text-[#DEDBC8] group-hover:translate-x-1 transition-all\" />\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* RIGHT PANEL: 3D Stage & Details (Desktop) */}\n        <div className=\"hidden lg:flex flex-col relative flex-1 bg-[#212121]/60 backdrop-blur-xl rounded-[2rem] border border-[#DEDBC8]/5 overflow-hidden\">\n           {/* Subtly textured background inside the stage */}\n           <div className=\"absolute inset-0 bg-noise opacity-[0.2] pointer-events-none mix-blend-overlay\"></div>\n           <div className=\"absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-80 pointer-events-none z-10\"></div>\n           \n           {/* Central Dynamic Stage */}\n           <div className=\"flex-1 flex flex-col items-center justify-between relative z-20 p-8 h-full\">\n              <div className=\"flex-1 flex items-center justify-center w-full\">\n                <div className=\"h-[450px] w-full flex items-center justify-center animate-in fade-in zoom-in duration-700\">\n                   <Book3D book={activeBook} onClick={() => {}} />\n                </div>\n              </div>\n\n              {activeBook && (\n                <div className=\"flex flex-col w-full bg-[#101010]/90 backdrop-blur-2xl p-8 rounded-[1.5rem] border border-[#DEDBC8]/10 animate-in slide-in-from-bottom-8 duration-500 shadow-2xl\">\n                  <div className=\"flex items-start justify-between gap-6 mb-6\">\n                    <div>\n                      <h3 className=\"font-serif text-[#DEDBC8] text-3xl mb-2\">{activeBook.title}</h3>\n                      <p className=\"font-sans text-[11px] text-[#DEDBC8]/50 uppercase tracking-[0.2em]\">{activeBook.author}</p>\n                    </div>\n                    <button \n                      onClick={() => setIsReading(true)}\n                      className=\"group relative flex items-center justify-center gap-3 bg-[#DEDBC8] text-black py-3 px-8 rounded-full font-medium hover:scale-[1.02] active:scale-95 transition-all outline-none shrink-0\"\n                    >\n                      <span className=\"uppercase tracking-widest text-xs font-semibold\">Start Reading</span>\n                      <ArrowRight className=\"w-4 h-4 shrink-0 transition-transform group-hover:translate-x-1\" />\n                    </button>\n                  </div>\n                  \n                  <div className=\"pt-6 border-t border-white/10 flex flex-col gap-4\">\n                    <h5 className=\"text-[10px] text-[#DEDBC8]/40 uppercase tracking-[0.2em]\">Book Summary</h5>\n                    <p className=\"text-sm leading-relaxed text-[#DEDBC8]/80 max-w-2xl\">\n                      {activeBook.summary || activeBook.excerpt}\n                    </p>\n                  </div>\n                </div>\n              )}\n           </div>\n        </div>\n      </div>\n\n      {/* Reader Modal */}\n      <ReaderOverlay \n        book={isReading ? activeBook : null} \n        onClose={() => setIsReading(false)} \n      />\n\n      {/* Horoscope Modal */}\n      <HoroscopePanel isOpen={view === \'horoscope\'} onClose={() => setView(\'library\')} />\n    </div>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
