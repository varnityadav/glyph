    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport CelestialBackground from \'./components/CelestialBackground\';\nimport Book3D from \'./components/Book3D\';\nimport ReaderOverlay from \'./components/ReaderOverlay\';\nimport HoroscopePanel from \'./components/HoroscopePanel\';\nimport { books, categories, Book } from \'./data\';\nimport { Menu, ArrowRight, Library, Sparkles, Hexagon } from \'lucide-react\';\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<\'vault\' | \'oracle\'>(\'oracle\');\n  const [activeCategory, setActiveCategory] = useState<string>(categories[0]);\n  const [activeBook, setActiveBook] = useState<Book | null>(books.find(b => b.category === categories[0]) || null);\n  const [isReading, setIsReading] = useState(false);\n\n  const filteredBooks = books.filter(b => b.category === activeCategory);\n\n  const handleCategorySelect = (category: string) => {\n    setActiveCategory(category);\n    const bookInCat = books.find(b => b.category === category);\n    if (bookInCat) setActiveBook(bookInCat);\n  };\n\n  return (\n    <div className=\"relative min-h-screen bg-[#050308] text-gray-100 font-sans selection:bg-fuchsia-500/30 overflow-hidden\">\n      <CelestialBackground />\n\n      {/* Main Layout Container */}\n      <div className=\"relative z-10 flex flex-col lg:flex-row min-h-screen p-4 lg:p-6 gap-4 lg:gap-6\">\n        \n        {/* LEFT PANEL */}\n        <div className=\"w-full lg:w-[58%] flex flex-col gap-4 lg:gap-6\">\n          \n          {/* Top Header / Branding */}\n          <div className=\"liquid-glass-strong rounded-3xl p-6 lg:px-8 flex justify-between items-center z-20 border border-white/5 shadow-2xl\">\n            <div className=\"flex flex-col\">\n              <div className=\"flex items-center gap-3\">\n                <Hexagon className=\"w-6 h-6 text-fuchsia-400\" strokeWidth={1.5} />\n                <h1 className=\"font-serif text-2xl tracking-[0.2em] text-white font-medium uppercase mt-1\">GLYPH <span className=\"opacity-40 font-light mx-2\">/</span> GVPH</h1>\n              </div>\n              <p className=\"text-[10px] uppercase tracking-[0.3em] text-white/40 mt-2 ml-10\">Exclusive Arcane Society</p>\n            </div>\n            \n            <button className=\"w-12 h-12 liquid-glass rounded-full flex items-center justify-center text-white/80 hover:text-white transition-all hover:scale-105 border border-white/10\">\n              <Menu className=\"w-5 h-5\" />\n            </button>\n          </div>\n\n          {/* Main Dashboard Dashboard */}\n          <div className=\"flex-1 liquid-glass-strong rounded-3xl p-6 lg:p-8 flex flex-col border border-white/5 relative shadow-2xl\">\n            {/* Tabs */}\n            <div className=\"flex gap-4 mb-8 border-b border-white/10 pb-4\">\n               <button \n                 onClick={() => setActiveTab(\'oracle\')}\n                 className={`font-serif text-xl tracking-wide transition-all px-2 ${activeTab === \'oracle\' ? \'text-white\' : \'text-white/30 hover:text-white/60\'}`}\n               >\n                 The Oracle\n               </button>\n               <button \n                 onClick={() => setActiveTab(\'vault\')}\n                 className={`font-serif text-xl tracking-wide transition-all px-2 ${activeTab === \'vault\' ? \'text-white\' : \'text-white/30 hover:text-white/60\'}`}\n               >\n                 The Vault\n               </button>\n            </div>\n\n            {/* Content Area */}\n            <div className=\"flex-1 flex flex-col relative\">\n              {activeTab === \'oracle\' ? (\n                 <HoroscopePanel />\n              ) : (\n                 <div className=\"flex-1 flex flex-col animate-in fade-in slide-in-from-bottom-4 duration-500\">\n                    <p className=\"text-white/60 mb-8 text-lg font-light leading-relaxed max-w-md\">\n                      Within the archives of GVPH, explore curated anthologies reserved for initiates of the highest order.\n                    </p>\n\n                    {/* Categories */}\n                    <div className=\"mb-8\">\n                      <p className=\"text-[10px] uppercase tracking-[0.2em] text-white/40 mb-4 font-medium flex items-center gap-2\">\n                        <Library className=\"w-3 h-3\" /> Select Realm\n                      </p>\n                      <div className=\"flex flex-wrap gap-2\">\n                        {categories.map((cat) => (\n                          <button\n                            key={cat}\n                            onClick={() => handleCategorySelect(cat)}\n                            className={`px-5 py-2.5 rounded-full text-xs tracking-widest uppercase transition-all duration-300 ${\n                              activeCategory === cat \n                              ? \'liquid-glass text-white border border-white/20\' \n                              : \'bg-transparent text-white/50 hover:bg-white/5 hover:text-white\'\n                            }`}\n                          >\n                            {cat}\n                          </button>\n                        ))}\n                      </div>\n                    </div>\n\n                    {/* Book List */}\n                    <div className=\"flex-1 min-h-[200px] overflow-y-auto scrollbar-hide pb-10\">\n                       <div className=\"space-y-3 pr-2\">\n                          {filteredBooks.map((book) => (\n                            <div \n                              key={book.id}\n                              onClick={() => setActiveBook(book)}\n                              className={`p-4 rounded-2xl cursor-pointer transition-all duration-300 flex items-center gap-5 ${\n                                activeBook?.id === book.id\n                                ? \'liquid-glass border border-white/20\'\n                                : \'hover:bg-white/5 border border-transparent\'\n                              }`}\n                            >\n                              <div className={`w-12 h-16 rounded shadow-lg ${book.coverColor} border border-white/10 shrink-0 relative overflow-hidden`}>\n                                 <div className=\"absolute inset-0 bg-gradient-to-br from-white/20 to-transparent mix-blend-overlay\"></div>\n                              </div>\n                              <div className=\"flex-1\">\n                                <h4 className=\"font-serif text-white text-lg leading-tight mb-1\">{book.title}</h4>\n                                <p className=\"font-sans text-[10px] text-white/50 uppercase tracking-[0.2em]\">{book.author}</p>\n                              </div>\n                              <div className={`w-8 h-8 rounded-full flex items-center justify-center transition-opacity ${activeBook?.id === book.id ? \'opacity-100 bg-white/10\' : \'opacity-0\'}`}>\n                                 <ArrowRight className=\"w-4 h-4 text-white\" />\n                              </div>\n                            </div>\n                          ))}\n                          {filteredBooks.length === 0 && (\n                             <p className=\"text-white/40 text-sm italic py-4\">No volumes available in this realm.</p>\n                          )}\n                       </div>\n                    </div>\n                 </div>\n              )}\n            </div>\n\n          </div>\n        </div>\n\n        {/* RIGHT PANEL (Desktop) */}\n        <div className=\"hidden lg:flex flex-col relative flex-1\">\n           {/* Top Right Utilities */}\n           <div className=\"flex justify-end gap-3 z-20 sticky top-0 right-0 p-2\">\n             <div className=\"liquid-glass-strong rounded-full px-6 py-3 flex items-center gap-6 border border-white/5\">\n                <span className=\"text-[10px] uppercase tracking-[0.2em] text-white/50 flex items-center gap-2\">\n                   <div className=\"w-1.5 h-1.5 rounded-full bg-emerald-400/80 shadow-[0_0_8px_rgba(52,211,153,0.8)]\"></div>\n                   Portal Open\n                </span>\n                <div className=\"w-px h-4 bg-white/10\"></div>\n                <button className=\"text-white hover:text-white/80 transition-colors flex items-center gap-2 text-xs font-medium uppercase tracking-widest\">\n                  Patron Login <ArrowRight className=\"w-3.5 h-3.5 opacity-60\" />\n                </button>\n             </div>\n           </div>\n\n           {/* Central Dynamic Stage */}\n           <div className=\"flex-1 flex flex-col items-center justify-center relative\">\n              <div className=\"absolute inset-10 rounded-[3rem] border border-white/[0.03] bg-gradient-to-b from-white/[0.01] to-transparent pointer-events-none\" />\n              \n              {activeTab === \'vault\' ? (\n                <>\n                  <div className=\"h-[450px] w-full flex items-center justify-center mb-12 animate-in fade-in zoom-in duration-700\">\n                     <Book3D book={activeBook} onClick={() => {}} />\n                  </div>\n\n                  {activeBook && (\n                    <div className=\"flex flex-col items-center liquid-glass p-8 rounded-[2rem] border border-white/10 max-w-sm w-full animate-in slide-in-from-bottom-8 duration-500\">\n                      <h3 className=\"font-serif text-white text-2xl mb-2 text-center\">{activeBook.title}</h3>\n                      <p className=\"font-sans text-[10px] text-white/50 uppercase tracking-[0.2em] mb-8 text-center\">{activeBook.author}</p>\n                      \n                      <button \n                        onClick={() => setIsReading(true)}\n                        className=\"group relative flex items-center justify-between w-full liquid-glass-strong border border-white/20 text-white py-4 px-6 rounded-full font-medium hover:scale-[1.02] active:scale-95 transition-all outline-none\"\n                      >\n                        <span className=\"uppercase tracking-widest text-xs\">Initiate Reading</span>\n                        <span className=\"w-8 h-8 rounded-full bg-white text-black flex items-center justify-center group-hover:bg-fuchsia-100 transition-colors\">\n                          <ArrowRight className=\"w-4 h-4\" />\n                        </span>\n                      </button>\n                    </div>\n                  )}\n                </>\n              ) : (\n                <div className=\"flex flex-col items-center justify-center h-full w-full opacity-60 animate-in fade-in duration-1000\">\n                   <div className=\"w-64 h-64 rounded-full border border-white/5 flex items-center justify-center relative mb-8\">\n                     <div className=\"absolute inset-0 rounded-full border border-white/10 scale-110\"></div>\n                     <div className=\"absolute inset-0 rounded-full border border-white/5 scale-125\"></div>\n                     <Sparkles className=\"w-12 h-12 text-fuchsia-400 opacity-50\" />\n                     <div className=\"absolute w-[200%] h-px bg-gradient-to-r from-transparent via-white/10 to-transparent rotate-45\"></div>\n                     <div className=\"absolute w-[200%] h-px bg-gradient-to-r from-transparent via-white/10 to-transparent -rotate-45\"></div>\n                   </div>\n                   <p className=\"font-serif text-2xl text-white tracking-widest text-center\">Astral Projection <br/><span className=\"text-white/40 italic\">Active</span></p>\n                </div>\n              )}\n           </div>\n        </div>\n      </div>\n\n      {/* Reader Modal */}\n      <ReaderOverlay \n        book={isReading ? activeBook : null} \n        onClose={() => setIsReading(false)} \n      />\n    </div>\n  );\n}"
      replacement_content: "import React, { useState } from \'react\';\nimport CelestialBackground from \'./components/CelestialBackground\';\nimport Book3D from \'./components/Book3D\';\nimport ReaderOverlay from \'./components/ReaderOverlay\';\nimport HoroscopePanel from \'./components/HoroscopePanel\';\nimport { books, categories, Book } from \'./data\';\nimport { Menu, ArrowRight, Library, Sparkles } from \'lucide-react\';\n\nexport default function App() {\n  const [activeCategory, setActiveCategory] = useState<string>(categories[0]);\n  const [activeBook, setActiveBook] = useState<Book | null>(books.find(b => b.category === categories[0]) || null);\n  const [isReading, setIsReading] = useState(false);\n  const [showHoroscope, setShowHoroscope] = useState(false);\n\n  const filteredBooks = books.filter(b => b.category === activeCategory);\n\n  const handleCategorySelect = (category: string) => {\n    setActiveCategory(category);\n    const bookInCat = books.find(b => b.category === category);\n    if (bookInCat) setActiveBook(bookInCat);\n  };\n\n  return (\n    <div className=\"relative min-h-screen bg-[#111116] text-gray-100 font-sans selection:bg-lavender-300/30 overflow-hidden\">\n      <CelestialBackground />\n\n      {/* Main Layout Container */}\n      <div className=\"relative z-10 flex flex-col lg:flex-row min-h-screen p-4 lg:p-6 gap-4 lg:gap-6\">\n        \n        {/* LEFT PANEL: Library Navigation */}\n        <div className=\"w-full lg:w-[45%] flex flex-col gap-4 lg:gap-6\">\n          \n          {/* Header */}\n          <div className=\"liquid-glass-strong rounded-[2rem] p-6 lg:px-8 flex justify-between items-center z-20 border border-white/5\">\n            <h1 className=\"font-serif text-3xl text-white font-medium lowercase tracking-tight\">glyph.</h1>\n            <button className=\"w-10 h-10 liquid-glass rounded-full flex items-center justify-center text-white/80 hover:text-white transition-all border border-white/10\">\n              <Menu className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n          {/* Library Content Area */}\n          <div className=\"flex-1 liquid-glass-strong rounded-[2rem] p-6 lg:p-8 flex flex-col border border-white/5 relative\">\n            <div className=\"flex-1 flex flex-col animate-in fade-in duration-500\">\n              <p className=\"text-white/60 mb-8 text-lg font-light leading-relaxed max-w-sm\">\n                A serene collection of thoughts, stories, and cosmic wisdom formatted for contemplation.\n              </p>\n\n              {/* Categories */}\n              <div className=\"mb-8\">\n                <p className=\"text-[10px] uppercase tracking-[0.2em] text-white/40 mb-4 font-medium flex items-center gap-2\">\n                  <Library className=\"w-3 h-3\" /> Select Topic\n                </p>\n                <div className=\"flex flex-wrap gap-2\">\n                  {categories.map((cat) => (\n                    <button\n                      key={cat}\n                      onClick={() => handleCategorySelect(cat)}\n                      className={`px-5 py-2.5 rounded-full text-xs tracking-widest uppercase transition-all duration-300 ${\n                        activeCategory === cat \n                        ? \'bg-white/10 text-white border border-white/20\' \n                        : \'bg-transparent text-white/50 hover:bg-white/5 hover:text-white\'\n                      }`}\n                    >\n                      {cat}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Book List */}\n              <div className=\"flex-1 min-h-[200px] overflow-y-auto scrollbar-hide pb-10\">\n                 <div className=\"space-y-3 pr-2\">\n                    {filteredBooks.map((book) => (\n                      <div \n                        key={book.id}\n                        onClick={() => setActiveBook(book)}\n                        className={`p-4 rounded-[1.25rem] cursor-pointer transition-all duration-300 flex items-center gap-5 ${\n                          activeBook?.id === book.id\n                          ? \'liquid-glass border border-white/10 shadow-[0_4px_20px_rgba(0,0,0,0.2)]\'\n                          : \'hover:bg-white/5 border border-transparent\'\n                        }`}\n                      >\n                        <div className={`w-12 h-16 rounded shadow-lg ${book.coverColor} border border-white/10 shrink-0 relative overflow-hidden`}>\n                           <div className=\"absolute inset-0 bg-gradient-to-br from-white/20 to-transparent mix-blend-overlay\"></div>\n                        </div>\n                        <div className=\"flex-1\">\n                          <h4 className=\"font-serif text-white text-lg leading-tight mb-1\">{book.title}</h4>\n                          <p className=\"font-sans text-[10px] text-white/50 uppercase tracking-[0.2em]\">{book.author}</p>\n                        </div>\n                        <div className={`w-8 h-8 rounded-full flex items-center justify-center transition-opacity ${activeBook?.id === book.id ? \'opacity-100 bg-white/10\' : \'opacity-0\'}`}>\n                           <ArrowRight className=\"w-4 h-4 text-white\" />\n                        </div>\n                      </div>\n                    ))}\n                    {filteredBooks.length === 0 && (\n                       <p className=\"text-white/40 text-sm italic py-4\">No volumes available in this realm.</p>\n                    )}\n                 </div>\n              </div>\n            </div>\n\n            {/* Bottom Actions / Horoscope Button */}\n            <div className=\"mt-4 pt-6 border-t border-white/10\">\n              <button \n                onClick={() => setShowHoroscope(true)}\n                className=\"w-full flex items-center justify-between p-4 rounded-2xl liquid-glass border border-white/5 hover:bg-white/5 transition-colors group\"\n              >\n                <div className=\"flex items-center gap-3 text-left\">\n                  <div className=\"w-10 h-10 rounded-full bg-white/5 flex items-center justify-center border border-white/10\">\n                    <Sparkles className=\"w-4 h-4 text-lavender-300\" />\n                  </div>\n                  <div>\n                    <h4 className=\"font-medium text-white/90 text-sm mb-0.5\">Cosmic Highlights</h4>\n                    <p className=\"text-[10px] uppercase tracking-widest text-white/40\">View your planetary alignments</p>\n                  </div>\n                </div>\n                <ArrowRight className=\"w-4 h-4 text-white/30 group-hover:text-white/70 transition-colors\" />\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* RIGHT PANEL: 3D Stage (Desktop) */}\n        <div className=\"hidden lg:flex flex-col relative flex-1 liquid-glass-strong rounded-[2rem] border border-white/5 p-8\">\n           {/* Central Dynamic Stage */}\n           <div className=\"flex-1 flex flex-col items-center justify-center relative\">\n              <div className=\"absolute inset-x-20 inset-y-10 rounded-[3rem] border border-white/[0.02] bg-gradient-to-b from-white/[0.01] to-transparent pointer-events-none\" />\n              \n              <div className=\"h-[450px] w-full flex items-center justify-center mb-12 animate-in fade-in zoom-in duration-700\">\n                 <Book3D book={activeBook} onClick={() => {}} />\n              </div>\n\n              {activeBook && (\n                <div className=\"flex flex-col items-center liquid-glass p-8 rounded-[2rem] border border-white/5 max-w-sm w-full animate-in slide-in-from-bottom-8 duration-500\">\n                  <h3 className=\"font-serif text-white text-2xl mb-2 text-center\">{activeBook.title}</h3>\n                  <p className=\"font-sans text-[10px] text-white/50 uppercase tracking-[0.2em] mb-8 text-center\">{activeBook.author}</p>\n                  \n                  <button \n                    onClick={() => setIsReading(true)}\n                    className=\"group relative flex items-center justify-between w-full bg-white/10 border border-white/20 text-white py-4 px-6 rounded-full font-medium hover:bg-white/20 hover:scale-[1.02] active:scale-95 transition-all outline-none\"\n                  >\n                    <span className=\"uppercase tracking-widest text-xs\">Begin Reading</span>\n                    <span className=\"w-8 h-8 rounded-full bg-white text-black flex items-center justify-center group-hover:bg-lavender-100 transition-colors\">\n                      <ArrowRight className=\"w-4 h-4\" />\n                    </span>\n                  </button>\n                </div>\n              )}\n           </div>\n        </div>\n      </div>\n\n      {/* Reader Modal */}\n      <ReaderOverlay \n        book={isReading ? activeBook : null} \n        onClose={() => setIsReading(false)} \n      />\n\n      {/* Horoscope Modal */}\n      <HoroscopePanel isOpen={showHoroscope} onClose={() => setShowHoroscope(false)} />\n    </div>\n  );\n}"
    }
