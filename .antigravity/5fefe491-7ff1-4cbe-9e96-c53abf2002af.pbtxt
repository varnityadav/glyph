  file_change {
    absolute_path_uri: "file:///src/components/HoroscopePanel.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { zodiacData, Zodiac } from \'../data\';\nimport { Sparkles, Activity } from \'lucide-react\';\n\nexport default function HoroscopePanel() {\n  const [selectedZodiac, setSelectedZodiac] = useState<Zodiac>(zodiacData[0]);\n  const [timeframe, setTimeframe] = useState<\'daily\' | \'yearly\'>(\'daily\');\n\n  return (\n    <div className=\"flex flex-col h-full gap-4\">\n      {/* Zodiac Selector Horizontal Scroll */}\n      <div className=\"w-full overflow-x-auto scrollbar-hide pb-2\">\n        <div className=\"flex gap-2 w-max\">\n          {zodiacData.map((zodiac) => (\n            <button\n              key={zodiac.id}\n              onClick={() => setSelectedZodiac(zodiac)}\n              className={`px-5 py-3 rounded-2xl whitespace-nowrap transition-all duration-300 border flex flex-col items-center gap-1 ${\n                selectedZodiac.id === zodiac.id\n                  ? \'liquid-glass-strong border-white/20 text-white\'\n                  : \'liquid-glass border-transparent text-white/50 hover:text-white/80\'\n              }`}\n            >\n              <span className=\"font-serif text-lg leading-none\">{zodiac.name}</span>\n              <span className=\"font-sans text-[10px] uppercase tracking-widest opacity-60\">\n                {zodiac.dateRange}\n              </span>\n            </button>\n          ))}\n        </div>\n      </div>\n\n      <div className=\"flex-1 flex flex-col lg:flex-row gap-4\">\n        {/* Main Reading Panel */}\n        <div className=\"flex-1 liquid-glass rounded-[2rem] p-6 lg:p-8 border border-white/5 flex flex-col relative overflow-hidden\">\n           <div className=\"absolute top-0 right-0 p-8 opacity-10\">\n              <Sparkles className=\"w-24 h-24\" />\n           </div>\n\n           <div className=\"flex items-center justify-between mb-8 relative z-10\">\n              <div>\n                <h3 className=\"font-serif text-3xl text-white mb-1\">{selectedZodiac.name}</h3>\n                <p className=\"font-sans text-xs text-white/50 uppercase tracking-widest\">Element: {selectedZodiac.element}</p>\n              </div>\n\n              {/* Toggle Timeframe */}\n              <div className=\"flex p-1 rounded-full liquid-glass border border-white/10\">\n                <button \n                  onClick={() => setTimeframe(\'daily\')}\n                  className={`px-4 py-1.5 rounded-full text-xs uppercase tracking-widest transition-all ${timeframe === \'daily\' ? \'bg-white/10 text-white\' : \'text-white/40 hover:text-white\'}`}\n                >\n                  Daily\n                </button>\n                <button \n                  onClick={() => setTimeframe(\'yearly\')}\n                  className={`px-4 py-1.5 rounded-full text-xs uppercase tracking-widest transition-all ${timeframe === \'yearly\' ? \'bg-white/10 text-white\' : \'text-white/40 hover:text-white\'}`}\n                >\n                  Yearly\n                </button>\n              </div>\n           </div>\n\n           <AnimatePresence mode=\"wait\">\n             <motion.div \n               key={selectedZodiac.id + timeframe}\n               initial={{ opacity: 0, y: 10 }}\n               animate={{ opacity: 1, y: 0 }}\n               exit={{ opacity: 0, y: -10 }}\n               className=\"flex-1 relative z-10\"\n             >\n               <h4 className=\"text-white/40 text-[10px] uppercase tracking-[0.2em] mb-4 flex items-center gap-2\">\n                 <Activity className=\"w-3 h-3\" />\n                 Currently Aligning\n               </h4>\n               <p className=\"font-serif text-white/90 text-xl lg:text-2xl leading-relaxed\">\n                 {timeframe === \'daily\' ? selectedZodiac.daily : selectedZodiac.yearly}\n               </p>\n             </motion.div>\n           </AnimatePresence>\n        </div>\n\n        {/* Chinese Zodiac Panel */}\n        <div className=\"w-full lg:w-1/3 liquid-glass rounded-[2rem] p-6 lg:p-8 border border-white/5 flex flex-col justify-between relative overflow-hidden group\">\n           <div className=\"absolute inset-0 bg-gradient-to-br from-lavender-500/5 to-transparent pointer-events-none\"></div>\n           <div>\n             <h4 className=\"text-white/40 text-[10px] uppercase tracking-[0.2em] mb-4\">Cosmic Counterpart</h4>\n             <h3 className=\"font-serif text-3xl text-white mb-2\">{selectedZodiac.chineseAlignment.sign}</h3>\n             <p className=\"font-sans text-xs text-white/60 lowercase tracking-widest border-l-2 border-lavender-500/30 pl-3\">\n               Chinese Zodiac Match\n             </p>\n           </div>\n\n           <p className=\"font-sans text-sm text-white/70 leading-relaxed mt-6\">\n             {selectedZodiac.chineseAlignment.description}\n           </p>\n        </div>\n      </div>\n    </div>\n  );\n}"
    }
